model AuditEvidence {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  controlId     String   @map("control_id") @db.Uuid
  periodId      String?  @map("period_id") @db.Uuid
  companyId     String?  @map("company_id") @db.Uuid
  title         String
  description   String?
  evidenceType  String   @map("evidence_type") @db.VarChar(60)
  source        String?
  storageKey    String?  @map("storage_key")
  payload       Json     @default("{}")
  checksum      String   @db.VarChar(64)
  version       Int      @default(1)
  collectedById String?  @map("collected_by_id") @db.Uuid
  collectedAt   DateTime @default(now()) @map("collected_at") @db.Timestamptz(6)

  @@index([controlId, collectedAt(sort: Desc)])
  @@index([periodId])
  @@index([companyId, collectedAt(sort: Desc)])
  @@map("audit_evidence")
}

