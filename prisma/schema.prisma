generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// User - Core user table for authentication, profile management, and access control
model User {
  /// Unique identifier (UUID)
  id                                                               String                          @id @default(uuid()) @db.Uuid
  /// Full name of the user
  name                                                             String
  /// Email address (unique, used for login)
  email                                                            String                          @unique
  /// Hashed password for authentication
  password                                                         String
  /// User role (admin, recruiter, hiring_manager, viewer)
  role                                                             String
  /// URL to user avatar image
  avatarUrl                                                        String?
  /// Alternative image URL
  image                                                            String?
  /// AI hint for data processing
  dataAiHint                                                       String?
  /// Authentication methods (basic, azure_ad) - supports multiple methods
  authenticationMethods                                            String[]                        @default(["basic"]) @map("authentication_methods")
  /// Flag to force password change on next login
  forcePasswordChange                                              Boolean                         @default(false) @map("force_password_change")
  /// Timestamp when email was verified
  emailVerified                                                    DateTime?
  /// Whether the user account is active
  isActive                                                         Boolean                         @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt                                                        DateTime                        @default(now())
  /// Last update timestamp
  updatedAt                                                        DateTime                        @updatedAt
  /// Azure AD Object ID for SSO
  azure_oid                                                        String?                         @unique
  /// Reference to user group
  userGroupId                                                      String?                         @map("userGroupId") @db.Uuid
  /// Reference to user team
  userTeamId                                                       String?                         @map("userTeamId") @db.Uuid
  /// Array of module permissions
  module_permissions                                               String[]                        @default([])
  /// Personal theme color
  personalColor                                                    String?                         @default("#2c5ecaff") @map("personal_color")
  /// Job title within the organization
  positionTitle                                                    String?                         @map("position_title")
  /// Department name
  department                                                       String?
  /// Contact phone number
  phoneNumber                                                      String?                         @map("phone_number")
  /// Office location
  officeLocation                                                   String?                         @map("office_location")
  /// Azure AD Employee ID
  employeeId                                                       String?                         @map("employee_id")
  /// Company name associated with user
  companyName                                                      String?                         @map("company_name")
  /// Employee type (Full-time, Contractor, etc.)
  employeeType                                                     String?                         @map("employee_type")
  /// Date of hire
  hireDate                                                         DateTime?                       @map("hire_date")
  /// Manager's display name
  manager                                                          String?
  /// Manager's email address
  managerEmail                                                     String?                         @map("manager_email")
  /// SAM Account Name (legacy)
  samAccountName                                                   String?                         @map("sam_account_name")
  /// Detailed contact info (JSON)
  contactInfo                                                      Json?                           @map("contact_info")
  /// Whether user is deleted from Azure AD
  deletedFromAD                                                    Boolean                         @default(false) @map("deleted_from_ad")
  /// Number of failed login attempts
  failedLoginAttempts                                              Int                             @default(0) @map("failed_login_attempts")
  /// Timestamp until which account is locked
  lockedUntil                                                      DateTime?                       @map("locked_until")
  /// Timestamp of last failed login
  lastFailedLogin                                                  DateTime?                       @map("last_failed_login")
  /// Whether 2FA is enabled
  twoFactorEnabled                                                 Boolean                         @default(false) @map("two_factor_enabled")
  /// 2FA method (totp, email)
  twoFactorMethod                                                  String?                         @map("two_factor_method")
  /// Encrypted 2FA secret
  twoFactorSecret                                                  String?                         @map("two_factor_secret")
  /// Encrypted backup codes
  twoFactorBackupCodes                                             String[]                        @default([]) @map("two_factor_backup_codes")
  /// Timestamp of 2FA verification
  twoFactorVerifiedAt                                              DateTime?                       @map("two_factor_verified_at")
  accounts                                                         Account[]
  applicants                                                       Applicant[]                     @relation("RecruiterApplicants")
  applicantComments                                                ApplicantComment[]              @relation("UserComments")
  evaluations                                                      ApplicantEvaluation[]
  createdEvaluationLinks                                           ApplicantEvaluationLink[]
  attachments                                                      Attachment[]                    @relation("UserAttachments")
  Dashboard                                                        Dashboard[]
  DashboardShare                                                   DashboardShare[]
  logEntries                                                       LogEntry[]                      @relation("UserLogEntries")
  notifications                                                    Notification[]
  positions                                                        Position[]                      @relation("RecruiterPositions")
  createdPositionInterviewers                                      PositionInterviewer[]           @relation("PositionInterviewerCreator")
  positionInterviewers                                             PositionInterviewer[]
  transitionRecords                                                TransitionRecord[]              @relation("ActingUserTransitions")
  userGroup                                                        UserGroup?                      @relation("UserUserGroup", fields: [userGroupId], references: [id])
  userTeam                                                         UserTeam?                       @relation("UserUserTeam", fields: [userTeamId], references: [id])
  activityLogs                                                     UserActivityLog[]               @relation("UserActivityLogs")
  sessions                                                         UserSession[]                   @relation("UserSessions")
  userPreferences                                                  UserUIDisplayPreference[]
  advance_transactions                                             advance_transactions[]
  applicantReadStatuses                                            ApplicantReadStatus[]           @relation("UserApplicantReadStatuses")
  applicantReminders                                               ApplicantReminder[]             @relation("UserReminders")
  broadcastCampaigns                                               BroadcastCampaign[]
  broadcastBannerEngagements                                       BroadcastBannerEngagement[]
  dataOperationJobs                                                DataOperationJob[]              @relation("UserDataOperationJobs")
  expense_activities                                               expense_activities[]
  expense_approvals_expense_approvals_approver_user_idToUser       expense_approvals[]             @relation("expense_approvals_approver_user_idToUser")
  expense_approvals_expense_approvals_delegated_from_user_idToUser expense_approvals[]             @relation("expense_approvals_delegated_from_user_idToUser")
  expense_exchange_rates                                           expense_exchange_rates[]
  expense_policy_versions                                          expense_policy_versions[]
  expense_receipts                                                 expense_receipts[]
  employeeProfile                                                  Employee?
  requestedScreeningCases                                          ScreeningCase[]                 @relation("ScreeningCaseRequester")
  reviewedScreeningFindings                                        ScreeningFinding[]              @relation("ScreeningFindingReviewer")
  hr_privacy_request_activities                                    hr_privacy_request_activities[]
  hr_privacy_requests                                              hr_privacy_requests[]
  createdJobOffers                                                 JobOffer[]                      @relation("JobOfferCreator")
  passwordSetupTokens                                              PasswordSetupToken[]
  uploadQueue                                                      UploadQueue[]                   @relation("UserUploadQueue")

  @@index([email])
  @@index([role])
  @@index([authenticationMethods])
  @@index([userGroupId])
  @@index([userTeamId])
  @@index([isActive])
  @@index([employeeId])
  @@index([deletedFromAD])
}

/// BroadcastCampaign - Persisted SMS, email, banner, and popup announcements
model BroadcastCampaign {
  id                String                      @id @default(uuid()) @db.Uuid
  channel           String                      @db.VarChar(16)
  title             String                      @db.VarChar(180)
  message           String
  audience          String                      @db.VarChar(40)
  status            String                      @db.VarChar(16)
  priority          String                      @default("normal") @db.VarChar(16)
  placement         String?                     @db.VarChar(24)
  backgroundColor   String?                     @map("background_color") @db.VarChar(7)
  fontColor         String?                     @map("font_color") @db.VarChar(7)
  scrollAnimation   String                      @default("none") @map("scroll_animation") @db.VarChar(12)
  ctaLabel          String?                     @map("cta_label") @db.VarChar(80)
  scheduledAt       DateTime?                   @map("scheduled_at") @db.Timestamptz(6)
  expiresAt         DateTime?                   @map("expires_at") @db.Timestamptz(6)
  recipientCount    Int                         @default(0) @map("recipient_count")
  failedCount       Int                         @default(0) @map("failed_count")
  providerMessageId String?                     @map("provider_message_id") @db.VarChar(255)
  errorMessage      String?                     @map("error_message")
  createdBy         String?                     @map("created_by") @db.Uuid
  createdByName     String                      @map("created_by_name") @db.VarChar(255)
  createdAt         DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator           User?                       @relation(fields: [createdBy], references: [id])
  engagements       BroadcastBannerEngagement[]

  @@index([createdAt(sort: Desc)], map: "broadcast_campaigns_history_idx")
  @@index([channel, status, scheduledAt, expiresAt], map: "broadcast_campaigns_active_idx")
  @@map("broadcast_campaigns")
}

/// Per-user delivery and acknowledgement tracking for in-app banners
model BroadcastBannerEngagement {
  id             String            @id @default(uuid()) @db.Uuid
  campaignId     String            @map("campaign_id") @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  seenAt         DateTime          @default(now()) @map("seen_at") @db.Timestamptz(6)
  acknowledgedAt DateTime?         @map("acknowledged_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign       BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId], map: "broadcast_banner_engagement_campaign_user_key")
  @@index([campaignId, acknowledgedAt], map: "broadcast_banner_engagement_report_idx")
  @@index([userId, acknowledgedAt], map: "broadcast_banner_engagement_user_idx")
  @@map("broadcast_banner_engagements")
}

/// PasswordSetupToken - One-time token used for initial account password setup
model PasswordSetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_setup_tokens")
}

/// UserActivityLog - Tracks all user-related actions for audit and security
model UserActivityLog {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Reference to the user
  userId      String   @map("user_id") @db.Uuid
  /// Action type (SIGN_IN, SIGN_OUT, PASSWORD_CHANGE, etc.)
  action      String
  /// Additional context for the action (JSON)
  details     Json?
  /// IP address of the request
  ipAddress   String?  @map("ip_address")
  /// Browser user agent string
  userAgent   String?  @map("user_agent")
  /// Who performed the action (for admin actions)
  performedBy String?  @map("performed_by") @db.Uuid
  /// Timestamp of the action
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([performedBy])
}

/// Position - Job positions available for recruitment
model Position {
  /// Unique identifier
  id                               String                     @id @default(uuid()) @db.Uuid
  /// Job title
  title                            String
  /// Department name
  department                       String
  /// Job description
  description                      String?
  /// Criteria for applicant matching
  matchCriteria                    String?
  /// Whether position is open for applications
  isOpen                           Boolean                    @default(true)
  /// Seniority level (Entry, Mid, Senior, etc.)
  positionLevel                    String?
  /// Assigned recruiter
  recruiterId                      String?                    @db.Uuid
  /// Leaf or legacy-resolved organization unit used for allocation enforcement
  organizationUnitId               String?                    @map("organization_unit_id") @db.Uuid
  /// Custom attributes (JSON)
  customAttributes                 Json?                      @default("{}")
  /// Record creation timestamp
  createdAt                        DateTime                   @default(now())
  /// Last update timestamp
  updatedAt                        DateTime                   @updatedAt
  /// Company identifier
  companyId                        String?                    @db.Uuid
  /// Reference to grade level
  gradeId                          String?                    @db.Uuid
  /// Additional position attributes
  positionAttribute                String?
  /// Default probation period applied to employees hired into this position
  probationPeriodDays              Int                        @default(90) @map("probation_period_days")
  /// Default cadence for probation evaluations
  probationEvaluationFrequencyDays Int                        @default(30) @map("probation_evaluation_frequency_days")
  applicants                       Applicant[]
  evaluations                      ApplicantEvaluation[]
  headcounts                       Headcount[]                @relation("PositionHeadcount")
  grade                            Grade?                     @relation(fields: [gradeId], references: [id])
  recruiter                        User?                      @relation("RecruiterPositions", fields: [recruiterId], references: [id])
  organizationUnit                 Department?                @relation("PositionOrganizationUnit", fields: [organizationUnitId], references: [id])
  expertiseGroups                  PositionExpertiseGroup[]
  expertiseSkills                  PositionExpertiseSkill[]
  interviewers                     PositionInterviewer[]
  personalityGroups                PositionPersonalityGroup[]
  personalityTraits                PositionPersonalityTrait[]
  transitionRecords                TransitionRecord[]
  employees                        Employee[]
  jobOffers                        JobOffer[]

  @@index([title])
  @@index([department])
  @@index([isOpen])
  @@index([recruiterId])
  @@index([organizationUnitId])
}

/// CompanyReference - Common company lookup data used by positions and Applicants
model CompanyReference {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Display company name
  name        String   @unique
  /// Registered or legal company name
  legalName   String?  @map("legal_name")
  /// Company logo URL or data URL
  logo        String?
  /// Public website
  website     String?
  /// Email/domain lookup key
  domain      String?
  /// Business industry
  industry    String?
  /// Shared company description
  description String?
  /// Contact email
  email       String?
  /// Contact phone
  phone       String?
  /// Postal address
  address     String?
  /// Country or region
  country     String?
  /// Additional common metadata
  metadata    Json?    @default("{}")
  /// Source system name
  source      String?  @default("manual")
  /// External source identifier
  externalId  String?  @unique @map("external_id")
  /// AppKit application id when loaded from AppKit
  appkitAppId String?  @map("appkit_app_id")
  /// Display sort order
  sortOrder   Int      @default(0) @map("sort_order")
  /// Whether the company can be selected and shown
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([domain])
  @@index([isActive])
  @@index([sortOrder])
}

/// Grade - Job grade levels with SLA and level configurations
model Grade {
  /// Unique identifier
  id          String     @id @default(uuid()) @db.Uuid
  /// Grade name (e.g., G1, G2)
  name        String     @unique
  /// Display label
  label       String?
  /// Grade description
  description String?
  /// Minimum level number
  minLevel    Int        @map("min_level")
  /// Maximum level number
  maxLevel    Int        @map("max_level")
  /// SLA days for this grade
  slaDays     Int        @map("sla_days")
  /// Display color
  color       String     @default("#3B82F6")
  /// Whether grade is active
  isActive    Boolean    @default(true) @map("is_active")
  /// Sort order for display
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positions   Position[]

  @@index([minLevel])
  @@index([maxLevel])
  @@index([isActive])
  @@index([sortOrder])
}

/// PositionLevel - Position seniority levels (Entry, Junior, Mid, Senior, etc.)
model PositionLevel {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Level name (e.g., Entry, Junior, Mid, Senior)
  name        String   @unique
  /// Level description
  description String?
  /// Display color
  color       String   @default("#6B7280")
  /// Whether level is active
  isActive    Boolean  @default(true) @map("is_active")
  /// Sort order for display
  sortOrder   Int      @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt   DateTime @default(now())
  /// Last update timestamp
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

/// Applicant - Job applicants and their application data
model Applicant {
  /// Unique identifier
  id                      String                    @id @default(uuid()) @db.Uuid
  /// Standalone person profile initialized when the person enters recruitment
  personProfileId         String?                   @map("person_profile_id") @db.Uuid
  /// Compatibility/search projection of the shared person profile name
  name                    String
  /// Compatibility/search projection of the shared personal email
  email                   String
  /// Compatibility/search projection of the shared phone number
  phone                   String?
  /// Applied position reference
  positionId              String?                   @db.Uuid
  /// Assigned recruiter reference
  recruiterId             String?                   @db.Uuid
  /// AI-calculated fit score (0-100)
  fitScore                Float?                    @default(0)
  /// Application submission date
  applicationDate         DateTime                  @default(now())
  /// Parsed resume data (JSON)
  parsedData              Json?
  /// Custom attributes (JSON)
  customAttributes        Json?                     @default("{}")
  /// Path to uploaded resume file
  resumePath              String?
  /// Record creation timestamp
  createdAt               DateTime                  @default(now())
  /// Last update timestamp
  updatedAt               DateTime                  @updatedAt
  /// Compatibility projection of the shared profile avatar
  avatarUrl               String?
  /// AI hint for processing
  dataAiHint              String?
  /// Justification for position assignment
  assignmentJustification String?
  /// Compatibility projection of shared education history
  educationData           Json?                     @default("[]")
  /// Compatibility projection of shared work experience history
  experienceData          Json?                     @default("[]")
  /// Company identifier
  companyId               String?                   @db.Uuid
  /// Applicant source reference
  sourceId                String?                   @db.Uuid
  /// Sub-source detail
  subSource               String?
  /// Current recruitment status
  statusId                String?                   @db.Uuid
  /// Whether applicant is blacklisted
  isBlacklisted           Boolean                   @default(false)
  /// Whether applicant is pinned
  isPinned                Boolean                   @default(false)
  /// Pin timestamp
  pinnedAt                DateTime?
  /// Email received date
  emailDate               DateTime?
  /// Email subject line
  emailSubject            String?
  /// Email message ID
  emailId                 String?
  /// Email metadata (JSON)
  emailMetadata           Json?
  /// Expected salary amount
  expectedSalary          Int?                      @map("expected_salary")
  personProfile           PersonProfile?            @relation(fields: [personProfileId], references: [id], onDelete: Restrict)
  position                Position?                 @relation(fields: [positionId], references: [id])
  recruiter               User?                     @relation("RecruiterApplicants", fields: [recruiterId], references: [id])
  source                  ApplicantSource?          @relation(fields: [sourceId], references: [id])
  recruitmentStage        RecruitmentStage?         @relation("RecruitmentStageApplicants", fields: [statusId], references: [id], onUpdate: NoAction)
  applicantComments       ApplicantComment[]
  evaluations             ApplicantEvaluation[]
  evaluationLinks         ApplicantEvaluationLink[]
  attachments             Attachment[]
  headcounts              Headcount[]               @relation("ApplicantHeadcount")
  jobMatches              JobMatch[]
  transitionRecords       TransitionRecord[]
  readStatuses            ApplicantReadStatus[]
  applicantReminders      ApplicantReminder[]
  employee                Employee?
  jobOffers               JobOffer[]
  screeningCases          ScreeningCase[]
  screeningConsents       ScreeningConsent[]

  @@index([email])
  @@index([personProfileId])
  @@index([positionId])
  @@index([recruiterId])
  @@index([applicationDate])
  @@index([fitScore])
  @@index([sourceId])
  @@index([statusId])
  @@index([isPinned])
  @@index([pinnedAt])
}

/// PersonProfile - Shared person-owned information independent of recruitment and employment
model PersonProfile {
  id               String      @id @default(uuid()) @db.Uuid
  firstName        String      @map("first_name")
  lastName         String      @map("last_name")
  preferredName    String?     @map("preferred_name")
  email            String
  phone            String?
  location         String?
  introduction     String?
  avatarUrl        String?     @map("avatar_url")
  education        Json        @default("[]")
  workExperience   Json        @default("[]") @map("work_experience")
  skills           Json        @default("[]")
  customAttributes Json        @default("{}") @map("custom_attributes")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  applicants       Applicant[]
  employee         Employee?

  @@index([email])
  @@index([lastName, firstName])
  @@map("person_profiles")
}

/// JobOffer - Tokenized offer letters with auditable electronic acceptance
model JobOffer {
  id                   String     @id @default(uuid()) @db.Uuid
  applicantId          String?    @map("applicant_id") @db.Uuid
  positionId           String?    @map("position_id") @db.Uuid
  recipientName        String     @map("recipient_name")
  recipientEmail       String     @map("recipient_email")
  jobTitle             String     @map("job_title")
  salaryAmount         Decimal?   @map("salary_amount") @db.Decimal(12, 2)
  currency             String     @default("THB")
  startDate            DateTime?  @map("start_date")
  status               String     @default("draft")
  token                String     @unique
  tokenExpiresAt       DateTime?  @map("token_expires_at")
  letterHtml           String     @map("letter_html")
  sentAt               DateTime?  @map("sent_at")
  acceptedAt           DateTime?  @map("accepted_at")
  signedName           String?    @map("signed_name")
  signedAt             DateTime?  @map("signed_at")
  signatureIp          String?    @map("signature_ip")
  signatureUserAgent   String?    @map("signature_user_agent")
  signatureConsentText String?    @map("signature_consent_text")
  signatureHash        String?    @map("signature_hash")
  createdById          String?    @map("created_by_id") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  applicant            Applicant? @relation(fields: [applicantId], references: [id])
  createdBy            User?      @relation("JobOfferCreator", fields: [createdById], references: [id])
  position             Position?  @relation(fields: [positionId], references: [id])

  @@index([applicantId])
  @@index([positionId])
  @@index([recipientEmail])
  @@index([status])
  @@index([token])
  @@map("job_offers")
}

/// ApplicantReadStatus - Tracks read/unread status per user per applicant
model ApplicantReadStatus {
  /// Unique identifier
  id          String    @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  applicantId String    @map("applicant_id") @db.Uuid
  /// Reference to user
  userId      String    @map("user_id") @db.Uuid
  /// Whether the applicant has been read by this user
  isRead      Boolean   @default(false) @map("is_read")
  /// Timestamp when applicant was marked as read
  readAt      DateTime? @map("read_at")
  /// Record creation timestamp
  createdAt   DateTime  @default(now()) @map("created_at")
  /// Last update timestamp
  updatedAt   DateTime  @updatedAt @map("updated_at")
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  user        User      @relation("UserApplicantReadStatuses", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([applicantId, userId])
  @@index([applicantId])
  @@index([userId])
  @@index([isRead])
  @@map("applicant_read_status")
}

/// ApplicantReminder - Reminders set by users for specific applicants
model ApplicantReminder {
  /// Unique identifier
  id           String    @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  applicantId  String    @map("applicant_id") @db.Uuid
  /// Reference to user who set the reminder
  userId       String    @map("user_id") @db.Uuid
  /// Reminder title
  title        String
  /// Additional reminder details
  content      String?
  /// When the reminder should trigger
  reminderDate DateTime  @map("reminder_date")
  /// Whether the reminder has been completed
  isCompleted  Boolean   @default(false) @map("is_completed")
  /// Record creation timestamp
  createdAt    DateTime  @default(now()) @map("created_at")
  /// Last update timestamp
  updatedAt    DateTime  @updatedAt @map("updated_at")
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  user         User      @relation("UserReminders", fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([userId])
  @@index([reminderDate])
  @@map("applicant_reminders")
}

/// RecruitmentStage - Pipeline stages for applicant recruitment workflow
model RecruitmentStage {
  /// Unique identifier
  id             String      @id @default(uuid()) @db.Uuid
  /// Stage name
  name           String      @unique
  /// Stage description
  description    String?
  /// Whether this is a system-defined stage
  isSystem       Boolean     @map("is_system")
  /// Sort order for display
  sortOrder      Int         @map("sort_order")
  /// Color when stage is complete
  color_complete String?
  /// Badge color
  color_badge    String?
  applicants     Applicant[] @relation("RecruitmentStageApplicants")

  @@index([sortOrder])
  @@index([isSystem])
}

/// TransitionRecord - History of applicant stage transitions
model TransitionRecord {
  /// Unique identifier
  id           String     @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  positionId   String?    @db.Uuid
  /// Transition date
  date         DateTime   @default(now())
  /// Stage name at transition
  stage        String
  /// Transition notes
  notes        String?
  /// User who performed the transition
  actingUserId String?    @db.Uuid
  /// Record creation timestamp
  createdAt    DateTime   @default(now())
  /// Last update timestamp
  updatedAt    DateTime   @updatedAt
  applicantId  String?    @map("applicant_id") @db.Uuid
  actingUser   User?      @relation("ActingUserTransitions", fields: [actingUserId], references: [id])
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  position     Position?  @relation(fields: [positionId], references: [id])

  @@index([applicantId])
  @@index([actingUserId])
  @@index([date])
  @@index([stage])
  @@index([positionId])
}

/// LogEntry - General system and application logging
model LogEntry {
  /// Unique identifier
  id           String   @id @default(uuid()) @db.Uuid
  /// Log timestamp
  timestamp    DateTime @default(now())
  /// Log level (INFO, WARN, ERROR, DEBUG)
  level        String
  /// Log message content
