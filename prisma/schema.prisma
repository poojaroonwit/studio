  applicantId           String?    @map("applicant_id") @db.Uuid
  applicant             Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([jobId])
  @@index([fitScore])
}

/// UploadQueue - Queue for processing uploaded resume files
model UploadQueue {
  /// Unique identifier
  id              String           @id @default(uuid()) @db.Uuid
  /// Original file name
  fileName        String           @map("file_name")
  /// File size in bytes
  fileSize        BigInt           @map("file_size")
  /// Processing status (pending, processing, completed, failed)
  status          String
  /// Error message if failed
  error           String?
  /// Detailed error information
  errorDetails    String?          @map("error_details")
  /// Source name
  source          String?
  /// Reference to applicant source
  sourceId        String?          @map("source_id") @db.Uuid
  /// Sub-source detail
  subSource       String?          @map("sub_source")
  /// Upload timestamp
  uploadDate      DateTime         @default(now()) @map("upload_date")
  /// Processing completion timestamp
  completedDate   DateTime?        @map("completed_date")
  /// Upload batch ID
  uploadId        String?          @map("upload_id")
  /// User who created the upload
  createdBy       String?          @map("created_by") @db.Uuid
  /// Last update timestamp
  updatedAt       DateTime         @default(now()) @map("updated_at")
  /// File storage path
  filePath        String           @map("file_path")
  /// Webhook response payload
  webhookPayload  Json?            @map("webhook_payload")
  /// Number of retry attempts
  retryCount      Int              @default(0) @map("retry_count")
  /// Target position reference
  positionId      String?          @map("position_id") @db.Uuid
  /// Processing date
  processDate     DateTime?        @map("process_date")
  /// Email received date
  emailDate       DateTime?        @map("email_date")
  /// Email subject line
  emailSubject    String?          @map("email_subject")
  /// Email message ID
  emailId         String?          @map("email_id")
  /// Email metadata (JSON)
  emailMetadata   Json?            @map("email_metadata")
  createdByUser   User?            @relation("UserUploadQueue", fields: [createdBy], references: [id])
  applicantSource ApplicantSource? @relation("UploadQueueApplicantSource", fields: [sourceId], references: [id])

  @@unique([filePath, status], name: "unique_file_path_status")
  @@index([status])
  @@index([uploadDate])
  @@index([completedDate])
  @@index([processDate])
  @@index([createdBy])
  @@index([source])
  @@index([sourceId])
  @@map("upload_queue")
}

/// DataOperationJob - Durable queue for recruiting data imports and exports
model DataOperationJob {
  id               String    @id @default(uuid()) @db.Uuid
  operation        String
  entityType       String    @map("entity_type")
  format           String?
  status           String    @default("pending")
  progress         Int       @default(0)
  originalFileName String?   @map("original_file_name")
  inputMimeType    String?   @map("input_mime_type")
  inputFileSize    BigInt?   @map("input_file_size")
  inputData        Bytes?    @map("input_data")
  parameters       Json?
  outputFileName   String?   @map("output_file_name")
  outputMimeType   String?   @map("output_mime_type")
  outputFileSize   BigInt?   @map("output_file_size")
  outputData       Bytes?    @map("output_data")
  result           Json?
  error            String?
  attempts         Int       @default(0)
  requestedById    String    @map("requested_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  requestedBy      User      @relation("UserDataOperationJobs", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([requestedById, createdAt])
  @@index([operation, entityType])
  @@map("data_operation_jobs")
}

/// UserUIDisplayPreference - User-specific UI display preferences
model UserUIDisplayPreference {
