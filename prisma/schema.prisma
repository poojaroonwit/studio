  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  message     String?
  visibility  String   @default("requester")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([requestId, createdAt], map: "support_activity_request_idx")
  @@map("employee_support_activities")
}

model ServiceDeskCategory {
  id                 String                         @id @default(uuid()) @db.Uuid
  companyId          String?                        @map("company_id") @db.Uuid
  key                String
  label              String
  isActive           Boolean                        @default(true) @map("is_active")
  aiEnabled          Boolean                        @default(false) @map("ai_enabled")
  systemPrompt       String                         @default("") @map("system_prompt") @db.Text
  sortOrder          Int                            @default(0) @map("sort_order")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  assignees          ServiceDeskCategoryAssignee[]
  knowledgeDocuments ServiceDeskKnowledgeDocument[]
  knowledgeChunks    ServiceDeskKnowledgeChunk[]

  @@index([companyId, sortOrder], map: "service_desk_categories_company_order_idx")
  @@map("service_desk_categories")
}

model ServiceDeskKnowledgeDocument {
  id               String                      @id @default(uuid()) @db.Uuid
  categoryId       String                      @map("category_id") @db.Uuid
  fileName         String                      @map("file_name")
  mimeType         String                      @map("mime_type")
  sizeBytes        Int                         @map("size_bytes")
  contentHash      String                      @map("content_hash")
  storageKey       String?                     @map("storage_key")
  status           String                      @default("ready")
  chunkCount       Int                         @default(0) @map("chunk_count")
  uploadedByUserId String?                     @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  category         ServiceDeskCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  chunks           ServiceDeskKnowledgeChunk[]

  @@unique([categoryId, fileName], map: "service_desk_knowledge_documents_category_file_key")
  @@index([categoryId, status], map: "service_desk_knowledge_documents_category_status_idx")
  @@map("service_desk_knowledge_documents")
}

model ServiceDeskKnowledgeChunk {
  id            String                       @id @default(uuid()) @db.Uuid
  documentId    String                       @map("document_id") @db.Uuid
  categoryId    String                       @map("category_id") @db.Uuid
  chunkIndex    Int                          @map("chunk_index")
  content       String                       @db.Text
  tokenEstimate Int                          @map("token_estimate")
  createdAt     DateTime                     @default(now()) @map("created_at")
  document      ServiceDeskKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  category      ServiceDeskCategory          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex], map: "service_desk_knowledge_chunks_document_index_key")
  @@index([categoryId], map: "service_desk_knowledge_chunks_category_idx")
  @@map("service_desk_knowledge_chunks")
}

model ServiceDeskCategoryAssignee {
