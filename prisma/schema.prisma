  /// Referenced attachment IDs
  attachmentIds String[]
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  author        User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([authorId])
}

/// Attachment - File attachments for applicants and headcounts
model Attachment {
  /// Unique identifier
  id           String     @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  applicantId  String?    @db.Uuid
  /// User who uploaded the file
  uploadedById String     @db.Uuid
  /// File storage path
  filePath     String
  /// Original file name
  fileName     String
  /// File label/category
  label        String
  /// Whether this is the primary attachment
  isPrimary    Boolean    @default(false)
  /// Upload timestamp
  uploadedAt   DateTime   @default(now())
  /// Last update timestamp
  updatedAt    DateTime   @updatedAt
  /// Reference to headcount
  headcountId  String?    @db.Uuid
  applicant    Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  headcount    Headcount? @relation("HeadcountAttachments", fields: [headcountId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("UserAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([headcountId])
  @@index([uploadedById])
  @@index([label])
  @@index([isPrimary])
}

/// Webhook - Outbound webhook configurations for event notifications
model Webhook {
  /// Unique identifier
  id                String              @id @default(uuid()) @db.Uuid
  /// Webhook name
  name              String
  /// Target URL
  url               String
  /// HTTP method (POST, PUT, etc.)
  method            String
  /// Custom headers (JSON)
  headers           Json?
  /// Custom auth header name
  auth_header_name  String?             @map("auth_header_name")
  /// Custom auth header value
  auth_header_value String?             @map("auth_header_value")
  /// Basic auth password
  auth_password     String?             @map("auth_password")
  /// Bearer token
  auth_token        String?             @map("auth_token")
  /// Auth type (none, basic, bearer, header)
  auth_type         String              @default("none") @map("auth_type")
  /// Basic auth username
  auth_username     String?             @map("auth_username")
  /// Record creation timestamp
  createdAt         DateTime            @default(now()) @map("createdAt")
  /// Event types to trigger on
  events            String[]
  /// Whether webhook is active
  is_active         Boolean             @default(true) @map("is_active")
  /// Number of retry attempts
  retry_count       Int                 @default(3) @map("retry_count")
  /// Request timeout in seconds
  timeout           Int                 @default(30)
  /// Last update timestamp
  updatedAt         DateTime            @updatedAt @map("updatedAt")
  /// Default body template
  body_template     String?             @map("body_template")
  /// Field mappings configuration
  field_mappings    Json?               @map("field_mappings")
  /// Include metadata in payload
  include_metadata  Boolean             @default(true) @map("include_metadata")
  /// Use custom payload format
  custom_payload    Boolean             @default(false) @map("custom_payload")
  body_configs      WebhookBodyConfig[]
  logs              WebhookLog[]

  @@index([is_active])
  @@index([events])
  @@index([createdAt])
}

/// WebhookBodyConfig - Custom body templates for webhook events
model WebhookBodyConfig {
  /// Unique identifier
  id             String   @id @default(uuid()) @db.Uuid
  /// Reference to webhook
  webhook_id     String   @map("webhook_id") @db.Uuid
  /// Event type for this config
  event_type     String   @map("event_type")
  /// Body template content
  body_template  String   @map("body_template")
  /// Field mappings (JSON)
  field_mappings Json?    @map("field_mappings")
  /// Whether config is active
  is_active      Boolean  @default(true) @map("is_active")
  /// Record creation timestamp
  created_at     DateTime @default(now()) @map("created_at")
  /// Last update timestamp
  updated_at     DateTime @updatedAt @map("updated_at")
  webhook        Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@unique([webhook_id, event_type])
  @@index([webhook_id])
  @@index([event_type])
  @@index([is_active])
}

/// WebhookLog - Execution logs for webhook deliveries
model WebhookLog {
  /// Unique identifier
  id              String   @id @default(uuid()) @db.Uuid
  /// Reference to webhook
  webhook_id      String   @map("webhook_id") @db.Uuid
  /// Event type triggered
  event_type      String   @map("event_type")
  /// Request payload (JSON)
  payload         Json
  /// HTTP response status code
  response_status Int?     @map("response_status")
  /// Response body content
  response_body   String?  @map("response_body")
  /// Whether delivery was successful
  success         Boolean
  /// Error message if failed
  error_message   String?  @map("error_message")
  /// Request duration in milliseconds
  duration_ms     Int      @default(0) @map("duration_ms")
  /// Log creation timestamp
  createdAt       DateTime @default(now()) @map("createdAt")
  webhook         Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id])
  @@index([event_type])
  @@index([success])
  @@index([createdAt])
}

/// Dashboard - Custom dashboard configurations for analytics
model Dashboard {
  /// Unique identifier
  id              String            @id @db.Uuid
  /// Dashboard name
  name            String
  /// Dashboard description
  description     String?
  /// Owner user reference
  userId          String            @db.Uuid
  /// Layout type (grid, list)
  layout          String            @default("grid")
  /// Visual theme
  theme           String            @default("default")
  /// Whether dashboard is publicly visible
  isPublic        Boolean           @default(false)
  /// Record creation timestamp
  createdAt       DateTime          @default(now())
  /// Last update timestamp
  updatedAt       DateTime
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  DashboardShare  DashboardShare[]
  DashboardWidget DashboardWidget[]

  @@index([createdAt])
  @@index([isPublic])
  @@index([updatedAt])
  @@index([userId])
}

/// DashboardShare - Dashboard sharing permissions between users
model DashboardShare {
  /// Unique identifier
  id          String    @id @db.Uuid
  /// Reference to dashboard
  dashboardId String    @db.Uuid
  /// Reference to user
  userId      String    @db.Uuid
  /// Permission level (view, edit)
  permission  String    @default("view")
  /// Record creation timestamp
  createdAt   DateTime  @default(now())
  /// Last update timestamp
  updatedAt   DateTime
  Dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([dashboardId])
  @@index([permission])
  @@index([userId])
}

/// DashboardWidget - Individual widgets within a dashboard
model DashboardWidget {
  /// Unique identifier
  id          String    @id @db.Uuid
  /// Reference to dashboard
  dashboardId String    @db.Uuid
  /// Widget type
  type        String
  /// Widget title
  title       String
  /// Widget configuration (JSON)
  config      Json?
  /// Position on dashboard (JSON)
  position    Json?
  /// Data source identifier
  dataSource  String?
  /// Record creation timestamp
  createdAt   DateTime  @default(now())
  /// Last update timestamp
  updatedAt   DateTime
  Dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([dashboardId])
  @@index([type])
}

/// SystemPromptCategory - Categories for organizing AI system prompts
model SystemPromptCategory {
  /// Unique identifier
  id            String         @id @default(uuid()) @db.Uuid
  /// Category name
  name          String         @unique
  /// Category description
  description   String?
  /// Display color
  color         String?        @default("#3B82F6")
  /// Whether category is active
  isActive      Boolean        @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt     DateTime       @default(now()) @map("created_at")
  /// Last update timestamp
  updatedAt     DateTime       @updatedAt @map("updated_at")
  systemPrompts SystemPrompt[]

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
}

/// SystemPrompt - AI system prompts for various recruitment tasks
model SystemPrompt {
  /// Unique identifier
  id          String               @id @default(uuid()) @db.Uuid
  /// Prompt name
  name        String
  /// Prompt description
  description String?
  /// Prompt content
  content     String
  /// Reference to category
  categoryId  String               @db.Uuid
  /// Whether prompt is active
  isActive    Boolean              @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt   DateTime             @default(now()) @map("created_at")
  /// Last update timestamp
  updatedAt   DateTime             @updatedAt @map("updated_at")
  category    SystemPromptCategory @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

/// ApplicantSource - Applicant sourcing channels (job portals, referrals, etc.)
model ApplicantSource {
  /// Unique identifier
  id               String        @id @default(uuid()) @db.Uuid
  /// Source name (e.g., LinkedIn, JobsDB)
  name             String        @unique
  /// Source description
  description      String?
  /// Whether sub-sources are allowed
  allowSubSource   Boolean       @default(false) @map("allow_sub_source")
  /// Sort order for display
  sortOrder        Int           @default(0) @map("sort_order")
  /// Whether source is active
  isActive         Boolean       @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt        DateTime      @default(now())
  /// Last update timestamp
  updatedAt        DateTime      @updatedAt
  /// Logo URL or path
  logo             String?
  /// Contact email for this source
  email            String?
  applicants       Applicant[]
  uploadQueueItems UploadQueue[] @relation("UploadQueueApplicantSource")

  @@index([sortOrder])
  @@index([isActive])
}

/// Notification - User notification messages
model Notification {
  /// Unique identifier
  id        String   @id @default(uuid()) @db.Uuid
  /// Target user reference
  userId    String   @db.Uuid
  /// Notification type
  type      String
  /// Notification title
  title     String
  /// Notification message body
  message   String
  /// Additional data (JSON)
  data      Json?    @default("{}")
  /// Whether notification has been read
  isRead    Boolean  @default(false)
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Last update timestamp
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

/// Headcount - Position headcount tracking for workforce planning
model Headcount {
  /// Unique identifier
  id             String       @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId     String       @db.Uuid
  /// Headcount type (new, replacement, expansion)
  type           String       @default("new")
  /// Current status (vacant, filled, pending)
  status         String       @default("vacant")
  /// Assigned applicant reference
  applicantId    String?      @db.Uuid
  /// Expected onboarding date
  onboardingDate DateTime?
  /// Request submission date
  requestDate    DateTime?
  /// Additional notes
  notes          String?
  /// Reference memo ID
  memoId         String?      @map("memo_id")
  /// Custom fields (JSON)
  customFields   Json?        @default("{}") @map("custom_fields")
  /// Employee ID once filled
  employeeId     String?      @map("employee_id")
  /// Record creation timestamp
  createdAt      DateTime     @default(now())
  /// Last update timestamp
  updatedAt      DateTime     @updatedAt
  attachments    Attachment[] @relation("HeadcountAttachments")
  applicant      Applicant?   @relation("ApplicantHeadcount", fields: [applicantId], references: [id])
  position       Position     @relation("PositionHeadcount", fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([applicantId])
  @@index([type])
  @@index([status])
  @@index([requestDate])
}

/// PositionInterviewer - Interviewers assigned to positions
model PositionInterviewer {
  /// Unique identifier
  id         String   @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId String   @db.Uuid
  /// Reference to user
  userId     String   @db.Uuid
  /// Record creation timestamp
  createdAt  DateTime @default(now())
  /// User who assigned interviewer
  createdBy  String?  @db.Uuid
  creator    User?    @relation("PositionInterviewerCreator", fields: [createdBy], references: [id])
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([positionId, userId])
  @@index([positionId])
  @@index([userId])
}

/// ExpertiseGroup - Groups of related expertise skills for evaluation
model ExpertiseGroup {
  /// Unique identifier
  id                  String                   @id @default(uuid()) @db.Uuid
  /// Group name
  name                String                   @unique
  /// Group description
  description         String?
  /// Display color
  color               String                   @default("#3B82F6")
  /// Whether group is active
  isActive            Boolean                  @default(true) @map("is_active")
  /// Sort order for display
  sortOrder           Int                      @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt           DateTime                 @default(now())
  /// Last update timestamp
  updatedAt           DateTime                 @updatedAt
  skills              ExpertiseSkill[]
  positionAssignments PositionExpertiseGroup[]
  templateAssignments SkillTemplateGroup[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

/// ExpertiseSkill - Individual expertise skills for applicant evaluation
model ExpertiseSkill {
  /// Unique identifier
  id                  String                    @id @default(uuid()) @db.Uuid
  /// Skill name
  name                String                    @unique
  /// Skill description
  description         String?
  /// Maximum score for this skill
  maxScore            Int                       @default(100) @map("max_score")
  /// Skill type (hard_skill, soft_skill)
  skillType           String                    @default("hard_skill") @map("skill_type")
  /// Whether skill is active
  isActive            Boolean                   @default(true) @map("is_active")
  /// Sort order for display
  sortOrder           Int                       @default(0) @map("sort_order")
  /// Reference to expertise group
  groupId             String?                   @db.Uuid
  /// Record creation timestamp
  createdAt           DateTime                  @default(now())
  /// Last update timestamp
  updatedAt           DateTime                  @updatedAt
  applicantScores     ApplicantExpertiseScore[]
  group               ExpertiseGroup?           @relation(fields: [groupId], references: [id])
  positionAssignments PositionExpertiseSkill[]
  templateAssignments SkillTemplateSkill[]

  @@index([name])
  @@index([skillType])
  @@index([isActive])
  @@index([sortOrder])
  @@index([groupId])
}

/// PersonalityGroup - Groups of related personality traits for evaluation
model PersonalityGroup {
  /// Unique identifier
  id                  String                          @id @default(uuid()) @db.Uuid
  /// Group name
  name                String                          @unique
  /// Group description
  description         String?
  /// Display color
  color               String                          @default("#10B981")
  /// Whether group is active
  isActive            Boolean                         @default(true) @map("is_active")
  /// Sort order for display
  sortOrder           Int                             @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt           DateTime                        @default(now())
  /// Last update timestamp
  updatedAt           DateTime                        @updatedAt
  traits              PersonalityTrait[]
  positionAssignments PositionPersonalityGroup[]
  templateAssignments SkillTemplatePersonalityGroup[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

/// PersonalityTrait - Individual personality traits for applicant evaluation
model PersonalityTrait {
  /// Unique identifier
  id                  String                          @id @default(uuid()) @db.Uuid
  /// Trait name
  name                String                          @unique
  /// Trait description
  description         String?
  /// Short description for display
  shortDescription    String?                         @map("short_description")
  /// Whether trait is active
  isActive            Boolean                         @default(true) @map("is_active")
  /// Sort order for display
  sortOrder           Int                             @default(0) @map("sort_order")
  /// Reference to personality group
  groupId             String?                         @db.Uuid
  /// Record creation timestamp
  createdAt           DateTime                        @default(now())
  /// Last update timestamp
  updatedAt           DateTime                        @updatedAt
  applicantScores     ApplicantPersonalityScore[]
  group               PersonalityGroup?               @relation(fields: [groupId], references: [id])
  positionAssignments PositionPersonalityTrait[]
  templateAssignments SkillTemplatePersonalityTrait[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
  @@index([groupId])
}

/// SkillTemplate - Reusable templates for skill and personality configurations
model SkillTemplate {
  /// Unique identifier
  id                        String                          @id @default(uuid()) @db.Uuid
  /// Template name
  name                      String                          @unique
  /// Template description
  description               String?
  /// Whether template is active
  isActive                  Boolean                         @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt                 DateTime                        @default(now())
  /// Last update timestamp
  updatedAt                 DateTime                        @updatedAt
  templateGroups            SkillTemplateGroup[]
  templatePersonalityGroups SkillTemplatePersonalityGroup[]
  templatePersonalityTraits SkillTemplatePersonalityTrait[]
  templateSkills            SkillTemplateSkill[]

  @@index([name])
  @@index([isActive])
}

/// SkillTemplateGroup - Expertise group assignments in skill templates
model SkillTemplateGroup {
  /// Unique identifier
  id         String         @id @default(uuid()) @db.Uuid
  /// Reference to template
  templateId String         @db.Uuid
  /// Reference to expertise group
  groupId    String         @db.Uuid
  /// Record creation timestamp
  createdAt  DateTime       @default(now())
  /// Last update timestamp
  updatedAt  DateTime       @updatedAt
  group      ExpertiseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  template   SkillTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, groupId])
  @@index([templateId])
  @@index([groupId])
}

/// SkillTemplateSkill - Expertise skill assignments in skill templates
model SkillTemplateSkill {
  /// Unique identifier
  id         String         @id @default(uuid()) @db.Uuid
  /// Reference to template
  templateId String         @db.Uuid
  /// Reference to expertise skill
  skillId    String         @db.Uuid
  /// Record creation timestamp
  createdAt  DateTime       @default(now())
  /// Last update timestamp
  updatedAt  DateTime       @updatedAt
  skill      ExpertiseSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  template   SkillTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, skillId])
  @@index([templateId])
  @@index([skillId])
}

/// SkillTemplatePersonalityGroup - Personality group assignments in skill templates
model SkillTemplatePersonalityGroup {
  /// Unique identifier
  id         String           @id @default(uuid()) @db.Uuid
  /// Reference to template
  templateId String           @db.Uuid
  /// Reference to personality group
  groupId    String           @db.Uuid
  /// Record creation timestamp
  createdAt  DateTime         @default(now())
  /// Last update timestamp
  updatedAt  DateTime         @updatedAt
  group      PersonalityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  template   SkillTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, groupId])
  @@index([templateId])
  @@index([groupId])
}

/// SkillTemplatePersonalityTrait - Personality trait assignments in skill templates
model SkillTemplatePersonalityTrait {
  /// Unique identifier
  id         String           @id @default(uuid()) @db.Uuid
  /// Reference to template
  templateId String           @db.Uuid
  /// Reference to personality trait
  traitId    String           @db.Uuid
  /// Record creation timestamp
  createdAt  DateTime         @default(now())
  /// Last update timestamp
  updatedAt  DateTime         @updatedAt
  template   SkillTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  trait      PersonalityTrait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([templateId, traitId])
  @@index([templateId])
  @@index([traitId])
}

/// PositionExpertiseGroup - Expertise group requirements for positions
model PositionExpertiseGroup {
  /// Unique identifier
  id         String         @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId String         @db.Uuid
  /// Reference to expertise group
  groupId    String         @db.Uuid
  /// Whether this group is required
  isRequired Boolean        @default(false) @map("is_required")
  /// Weight for scoring
  weight     Float          @default(1.0)
  /// Record creation timestamp
  createdAt  DateTime       @default(now())
  /// Last update timestamp
  updatedAt  DateTime       @updatedAt
  group      ExpertiseGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position   Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, groupId])
  @@index([positionId])
  @@index([groupId])
}

/// PositionExpertiseSkill - Expertise skill requirements for positions
model PositionExpertiseSkill {
  /// Unique identifier
  id         String         @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId String         @db.Uuid
  /// Reference to expertise skill
  skillId    String         @db.Uuid
  /// Whether this skill is required
  isRequired Boolean        @default(false) @map("is_required")
  /// Weight for scoring
  weight     Float          @default(1.0)
  /// Minimum required score
  minScore   Int?           @map("min_score")
  /// Record creation timestamp
  createdAt  DateTime       @default(now())
  /// Last update timestamp
  updatedAt  DateTime       @updatedAt
  position   Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  skill      ExpertiseSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([positionId, skillId])
  @@index([positionId])
  @@index([skillId])
}

/// PositionPersonalityGroup - Personality group requirements for positions
model PositionPersonalityGroup {
  /// Unique identifier
  id         String           @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId String           @db.Uuid
  /// Reference to personality group
  groupId    String           @db.Uuid
  /// Whether this group is required
  isRequired Boolean          @default(false) @map("is_required")
  /// Weight for scoring
  weight     Float            @default(1.0)
  /// Record creation timestamp
  createdAt  DateTime         @default(now())
  /// Last update timestamp
  updatedAt  DateTime         @updatedAt
  group      PersonalityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position   Position         @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, groupId])
  @@index([positionId])
  @@index([groupId])
}

/// PositionPersonalityTrait - Personality trait requirements for positions
model PositionPersonalityTrait {
  /// Unique identifier
  id         String           @id @default(uuid()) @db.Uuid
  /// Reference to position
  positionId String           @db.Uuid
  /// Reference to personality trait
  traitId    String           @db.Uuid
  /// Whether this trait is required
  isRequired Boolean          @default(false) @map("is_required")
  /// Weight for scoring
  weight     Float            @default(1.0)
  /// Record creation timestamp
  createdAt  DateTime         @default(now())
  /// Last update timestamp
  updatedAt  DateTime         @updatedAt
  position   Position         @relation(fields: [positionId], references: [id], onDelete: Cascade)
  trait      PersonalityTrait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([positionId, traitId])
  @@index([positionId])
  @@index([traitId])
}

/// ApplicantEvaluation - Evaluation records for applicant assessments
model ApplicantEvaluation {
  /// Unique identifier
  id                String                      @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  applicantId       String                      @db.Uuid
  /// Reference to position
  positionId        String?                     @db.Uuid
  /// Reference to evaluator
  evaluatorId       String                      @db.Uuid
  /// Evaluation status (in_progress, completed)
  status            String                      @default("in_progress")
  /// Overall evaluation score
  overallScore      Float?                      @map("overall_score")
  /// Evaluator comments
  comments          String?
  /// Completion timestamp
  completedAt       DateTime?                   @map("completed_at")
  /// Record creation timestamp
  createdAt         DateTime                    @default(now())
  /// Last update timestamp
  updatedAt         DateTime                    @updatedAt
  applicant         Applicant                   @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  evaluator         User                        @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  position          Position?                   @relation(fields: [positionId], references: [id])
  expertiseScores   ApplicantExpertiseScore[]
  personalityScores ApplicantPersonalityScore[]

  @@index([applicantId])
  @@index([positionId])
  @@index([evaluatorId])
  @@index([status])
  @@index([createdAt])
}

/// ApplicantEvaluationLink - Secure links for external applicant evaluation
model ApplicantEvaluationLink {
  /// Unique identifier
  id           String    @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  applicantId  String    @db.Uuid
  /// Secure access token
  token        String    @unique
  /// Token expiration timestamp
  expiresAt    DateTime
  /// User who created the link
  createdById  String    @db.Uuid
  /// Whether login is required to access
  requireLogin Boolean   @default(true)
  /// Link revocation timestamp
  revokedAt    DateTime?
  /// Record creation timestamp
  createdAt    DateTime  @default(now())
  /// Last update timestamp
  updatedAt    DateTime  @updatedAt
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@index([expiresAt])
}

/// ApplicantExpertiseScore - Recorded scores for expertise skills
model ApplicantExpertiseScore {
  /// Unique identifier
  id           String              @id @default(uuid()) @db.Uuid
  /// Reference to evaluation
  evaluationId String              @db.Uuid
  /// Reference to skill
  skillId      String              @db.Uuid
  /// Score value
  score        Int
  /// Optional notes on score
  notes        String?
  /// Record creation timestamp
  createdAt    DateTime            @default(now())
  /// Last update timestamp
  updatedAt    DateTime            @updatedAt
  evaluation   ApplicantEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  skill        ExpertiseSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, skillId])
  @@index([evaluationId])
  @@index([skillId])
}

/// ApplicantPersonalityScore - Recorded scores for personality traits
model ApplicantPersonalityScore {
  /// Unique identifier
  id           String              @id @default(uuid()) @db.Uuid
  /// Reference to evaluation
  evaluationId String              @db.Uuid
  /// Reference to personality trait
  traitId      String              @db.Uuid
  /// Score value
  score        Int
  /// Optional notes on score
  notes        String?
  /// Record creation timestamp
  createdAt    DateTime            @default(now())
  /// Last update timestamp
  updatedAt    DateTime            @updatedAt
  evaluation   ApplicantEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  trait        PersonalityTrait    @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, traitId])
  @@index([evaluationId])
  @@index([traitId])
}

/// User Session - tracks active sessions for single-device login enforcement
model UserSession {
  /// Unique identifier
  id             String   @id @default(uuid()) @db.Uuid
  /// Reference to user
  userId         String   @map("user_id") @db.Uuid
  /// Unique session token
  sessionToken   String   @unique @map("session_token")
  /// Device information string
  deviceInfo     String?  @map("device_info")
  /// Client IP address
  ipAddress      String?  @map("ip_address")
  /// Client user agent
  userAgent      String?  @map("user_agent")
  /// Whether session is active
  isActive       Boolean  @default(true) @map("is_active")
  /// Session creation timestamp
  createdAt      DateTime @default(now()) @map("created_at")
  /// Session expiration timestamp
  expiresAt      DateTime @map("expires_at")
  /// Last activity timestamp
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  user           User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([expiresAt])
}

/// SystemApiKey - API keys for external system/service authentication (v2 API)
model SystemApiKey {
  /// Unique identifier
  id          String    @id @default(uuid()) @db.Uuid
  /// Display name for the API key
  name        String
  /// Optional description of the key's purpose
  description String?
  /// First 12 characters of the key for identification (e.g., "sk_live_abc1")
  keyPrefix   String    @map("key_prefix")
  /// SHA-256 hash of the full API key
  keyHash     String    @unique @map("key_hash")
  /// Whether the API key is active
  isActive    Boolean   @default(true) @map("is_active")
  /// Optional expiration timestamp (null = never expires)
  expiresAt   DateTime? @map("expires_at")
  /// Last time this key was used
  lastUsedAt  DateTime? @map("last_used_at")
  /// IP address of last request using this key
  lastUsedIp  String?   @map("last_used_ip")
  /// Number of times this key has been used
  usageCount  Int       @default(0) @map("usage_count")
  /// User who created this API key
  createdById String?   @map("created_by_id") @db.Uuid
  /// Record creation timestamp
  createdAt   DateTime  @default(now())
  /// Last update timestamp
  updatedAt   DateTime  @updatedAt

  @@index([keyHash])
  @@index([isActive])
  @@index([expiresAt])
  @@index([createdById])
}

/// Department - HR organizational departments separate from auth teams
model Department {
  id                  String     @id @default(uuid()) @db.Uuid
  name                String
  code                String?    @unique
  division            String     @default("General")
  department          String     @default("General")
  section             String     @default("General")
  unitType            String     @default("unit") @map("unit_type")
  parentId            String?    @map("parent_id") @db.Uuid
  sortOrder           Int        @default(0) @map("sort_order")
  description         String?
