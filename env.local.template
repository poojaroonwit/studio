# =================================================================
# Local Development Environment Configuration
# =================================================================
# This file contains environment variables for local development
# Copy this file to .env.local and update values as needed


# =================================================================
# Application Configuration
# =================================================================
NODE_ENV=development
APP_PORT=8021
NEXT_TELEMETRY_DISABLED=1
APP_TIMEZONE=Asia/Bangkok


# =================================================================
# Database Configuration (PostgreSQL)
# =================================================================
# The application only reads DATABASE_URL for PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# =================================================================
# Object Storage Configuration (S3-compatible)
# =================================================================
# The app accepts STORAGE_*, S3_*, AWS_* and legacy MINIO_* names.
# Prefer STORAGE_* for new deployments. MinIO root credentials are only
# needed when running the local MinIO container.
MINIO_ROOT_USER=fitscan-user
MINIO_ROOT_PASSWORD=CDkFnCt2MhyDWBpS3deBV4N5eDCdsWW3
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=fitscan-user
STORAGE_SECRET_ACCESS_KEY=CDkFnCt2MhyDWBpS3deBV4N5eDCdsWW3
STORAGE_BUCKET=fitscan
STORAGE_PUBLIC_BASE_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# =================================================================
# Authentication Configuration
# =================================================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=fitscan-local-nextauth-secret-change-me-32
NEXTAUTH_URL=http://localhost:8021

# =================================================================
# CORS Configuration (Security)
# =================================================================
# Comma-separated list of allowed origins for CORS requests
# Supports wildcard patterns like *.qsncc.com (all subdomains)
# Example: http://localhost:3000,http://localhost:8021,*.qsncc.com
# Note: *.qsncc.com is automatically allowed for all subdomains
# 
# Azure AD SSO Note: Azure AD domains are automatically added when Azure AD is configured.
# Azure AD SSO typically uses redirects (not CORS), so explicit CORS configuration
# is usually not required for SSO. However, Azure AD domains are automatically
# allowed if AZURE_AD_CLIENT_ID, AZURE_AD_CLIENT_SECRET, and AZURE_AD_TENANT_ID are set.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8021,http://127.0.0.1:3000,http://127.0.0.1:8021


# =================================================================
# Azure AD Configuration (Optional - for SSO)
# =================================================================
# If you want to use Azure AD for authentication, uncomment and configure these
# AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
# AZURE_AD_TENANT_ID=your_azure_ad_tenant_id
# NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# NEXT_PUBLIC_AZURE_AD_TENANT_ID=your_azure_ad_tenant_id


# =================================================================
# External API Keys (Optional)
# =================================================================
# Google API Key for fonts and other Google services
# GOOGLE_API_KEY=your_google_api_key
# NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=your_google_api_key


# =================================================================
# Webhook Configuration (Optional)
# =================================================================
# URLs for external webhook processing (leave empty for local development)
# RESUME_PROCESSING_WEBHOOK_URL=your_resume_processing_webhook_url
# RESUME_PROCESSING_WEBHOOK_TOKEN=your_resume_processing_webhook_token
# GENERAL_PDF_WEBHOOK_URL=your_general_pdf_webhook_url
# GENERAL_PDF_WEBHOOK_TOKEN=your_general_pdf_webhook_token
# RESUME_PROCESSING_WEBHOOK_TIMEOUT=1800
# WEBHOOK_CONNECTION_TIMEOUT=900
PROCESSOR_API_KEY=local-dev-api-key
PROCESSOR_URL=http://localhost:8021
UPLOAD_QUEUE_PROCESS_URL=http://localhost:8021/api/upload-queue/process

# Upload Queue Processor Configuration - FIXED TIMING (no dynamic adjustments)
PROCESSOR_INTERVAL_MS=5000           # Fixed interval: 5000ms (5 seconds) - no dynamic adjustments
MAX_CONCURRENT_PROCESSORS=1          # Default to 1 for connection optimization, can be increased via system settings
LOG_INTERVAL_MS=5000                 # Status logging interval: 5000ms (5 seconds)

# Processor Configuration
PROCESSOR_QUIET_MODE=false           # Set to true to reduce console output
PROCESSOR_CONNECTION_TIMEOUT_MS=30000 # Connection timeout for processor requests (30 seconds)
PROCESSOR_REQUEST_TIMEOUT_MS=1800000 # Request timeout for processor requests (30 minutes to match webhook timeout)

# Resilience Configuration (hardcoded in processor script, not configurable via env)
# MAX_CONSECUTIVE_ERRORS=10 # Maximum consecutive errors before backoff
# MAX_BACKOFF_MS=300000 # Maximum backoff time (5 minutes)


# =================================================================
# Real-time Configuration (SSE)
# =================================================================
# SSE is used for real-time updates instead of WebSocket
# UNIFIED: All SSE endpoints now use single connection per user
# No additional configuration needed for SSE








# =================================================================
# Development Configuration
# =================================================================
# Note: INTERNAL_SERVER_IP and INTERNAL_DOMAIN are not used in the application

# SECURITY: File access configuration
# ALLOW_PUBLIC_FILES=false  # NEVER set to true - security risk!
# USE_SIGNED_URLS_IN_WEBHOOKS=true  # Always use signed URLs for secure access


