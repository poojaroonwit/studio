# Production Environment Configuration
NODE_ENV=production
APP_PORT=8021
NEXT_TELEMETRY_DISABLED=1
APP_TIMEZONE=Asia/Bangkok

# Database Configuration (PostgreSQL)
# For local development, use localhost:8521
# For production with Docker, use postgres:5432
DATABASE_URL=postgresql://postgres:secure_password@localhost:8521/studio_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password
POSTGRES_DB=studio_production
POSTGRES_HOST=localhost
POSTGRES_PORT=8521
POSTGRES_EXTERNAL_PORT=8521

# Production Docker settings (uncomment for production deployment)
# DATABASE_URL=postgresql://postgres:secure_password@postgres:5432/studio_production
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Database Connection Pool Configuration
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_IDLE_TIMEOUT=5000
DATABASE_CONNECTION_TIMEOUT=5000
DATABASE_STATEMENT_TIMEOUT=5000

# MinIO Object Storage Configuration
# For local development, use localhost
# For production with Docker, use minio
