# Process Queue Processor Configuration
# Copy these environment variables to your .env.local file

# API Configuration
PROCESSOR_API_KEY=your-api-key-here
PROCESSOR_URL=http://localhost:8021

# Processing Configuration
PROCESSOR_INTERVAL_MS=5000          # Check for jobs every 5 seconds
PROCESSOR_BATCH_LIMIT=10            # Process up to 10 jobs per batch
LOG_INTERVAL_MS=30000               # Log status every 30 seconds

# Database Configuration (if running processor separately)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# System Settings (these will be set in the database)
# maxConcurrentProcessors=5         # Set via admin panel or database
# resumeProcessingWebhookUrl=       # Set via admin panel
# resumeProcessingWebhookToken=     # Set via admin panel
