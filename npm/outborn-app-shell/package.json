{
  "name": "@outborn/app-shell",
  "version": "0.1.5",
  "description": "Shared Outborn application launcher and app-switcher UI for React products",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["src"],
  "sideEffects": ["./src/styles.css"],
  "peerDependencies": {
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20"
  },
  "engines": { "node": ">=18" },
  "license": "UNLICENSED"
}
