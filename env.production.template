MINIO_ENDPOINT=localhost
MINIO_PORT=8621
MINIO_ACCESS_KEY=minioaccesskey
MINIO_SECRET_KEY=miniosecretkey
MINIO_BUCKET_NAME=studio-production
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:8721
MINIO_API_PORT=8621
MINIO_CONSOLE_PORT=8721

