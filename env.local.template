# =================================================================
# Local Development Environment Configuration
# =================================================================
# This file contains environment variables for local development
# Copy this file to .env.local and update values as needed


# =================================================================
# Application Configuration
# =================================================================
NODE_ENV=development
APP_PORT=8021
NEXT_TELEMETRY_DISABLED=1
APP_TIMEZONE=Asia/Bangkok


# =================================================================
# Database Configuration (PostgreSQL)
# =================================================================
# For local development - adjust these values as needed
POSTGRES_USER=studio_user
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=studio_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://studio_user:local_dev_password@localhost:5432/studio_dev

# Database Connection Pool Configuration - OPTIMIZED for single connection per user
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=30          # ✅ Increased from 20 to 30
DATABASE_IDLE_TIMEOUT=5000           # ✅ Reduced to 5s
DATABASE_CONNECTION_TIMEOUT=600000   # ✅ Reduced from 30min to 10min
DATABASE_STATEMENT_TIMEOUT=180000    # ✅ Increased from 30s to 3min


# =================================================================
# MinIO Object Storage Configuration
# =================================================================
# For local development - adjust these values as needed
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=studio-dev
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9001
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001


# =================================================================
# Authentication Configuration
# =================================================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-local-development-secret-key-change-this
NEXTAUTH_URL=http://localhost:8021


# =================================================================
# Azure AD Configuration (Optional - for SSO)
# =================================================================
# If you want to use Azure AD for authentication, uncomment and configure these
# AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
# AZURE_AD_TENANT_ID=your_azure_ad_tenant_id
# NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# NEXT_PUBLIC_AZURE_AD_TENANT_ID=your_azure_ad_tenant_id


# =================================================================
# External API Keys (Optional)
# =================================================================
# Google API Key for fonts and other Google services
# GOOGLE_API_KEY=your_google_api_key
# NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=your_google_api_key


# =================================================================
# Webhook Configuration (Optional)
# =================================================================
# URLs for external webhook processing (leave empty for local development)
# RESUME_PROCESSING_WEBHOOK_URL=your_resume_processing_webhook_url
# RESUME_PROCESSING_WEBHOOK_TOKEN=your_resume_processing_webhook_token
# GENERAL_PDF_WEBHOOK_URL=your_general_pdf_webhook_url
# GENERAL_PDF_WEBHOOK_TOKEN=your_general_pdf_webhook_token
# RESUME_PROCESSING_WEBHOOK_TIMEOUT=1800
# WEBHOOK_CONNECTION_TIMEOUT=900
PROCESSOR_API_KEY=local-dev-api-key
PROCESSOR_URL=http://localhost:8021
UPLOAD_QUEUE_PROCESS_URL=http://localhost:8021/api/upload-queue/process

# Upload Queue Processor Configuration - FIXED TIMING (no dynamic adjustments)
PROCESSOR_INTERVAL_MS=5000           # Fixed interval: 5000ms (5 seconds) - no dynamic adjustments
MAX_CONCURRENT_PROCESSORS=1          # Default to 1 for connection optimization, can be increased via system settings
LOG_INTERVAL_MS=5000                 # Status logging interval: 5000ms (5 seconds)

# Processor Batch Configuration
PROCESSOR_BATCH_LIMIT=1              # ✅ Default batch size, adjusts based on concurrent processors
PROCESSOR_QUIET_MODE=false           # Set to true to reduce console output
PROCESSOR_CONNECTION_TIMEOUT_MS=60000 # Connection timeout for processor requests
PROCESSOR_REQUEST_TIMEOUT_MS=180000  # Request timeout for processor requests


# =================================================================
# Real-time Configuration (SSE)
# =================================================================
# SSE is used for real-time updates instead of WebSocket
# UNIFIED: All SSE endpoints now use single connection per user
# No additional configuration needed for SSE


# =================================================================
# Public MinIO Configuration (Client-side accessible)
# =================================================================
NEXT_PUBLIC_MINIO_BUCKET=studio-dev
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://localhost:9001
NEXT_PUBLIC_MINIO_URL=http://localhost:9001
NEXT_PUBLIC_MINIO_BUCKET_NAME=studio-dev


