# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-SQLI:
    - src/app/api/candidates/route.ts > *:
        reason: >-
          Uses parameterized queries with whitelisted column maps (sortMap). No
          user input is interpolated directly.
        expires: '2027-01-14T00:00:00.000Z'
    - src/app/api/candidates/fit-score-counts/route.ts > *:
        reason: >-
          Uses parameterized queries ($1, $2) with whitelisted fragments. No
          user input is interpolated directly.
        expires: '2027-01-14T00:00:00.000Z'
  SNYK-JS-DOMXSS:
    - src/components/positions/HeadcountAttachmentModal.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/settings/WebhookManagement.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/candidates/CandidateImportModal.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/candidates/CandidatesPageClient.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/candidates/tabs/AttachmentsTab.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/app/settings/users/*/warning-configurations/page.tsx > *:
        reason: >-
          Blob URL validated via sanitizeUrl() before appendChild. Safe file
          download pattern.
        expires: '2027-01-14T00:00:00.000Z'
    - src/app/interview/page.tsx > *:
        reason: >-
          Canvas toBlob() produces safe local blob URL. Validated via
          sanitizeUrl().
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/candidates/FullCandidateDetail.tsx > *:
        reason: >-
          Canvas toBlob() produces safe local blob URL. Validated via
          sanitizeUrl().
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/settings/EvaluationLinksTab.tsx > *:
        reason: >-
          Canvas toBlob() produces safe local blob URL. Validated via
          sanitizeUrl(). href uses sanitizeUrl().
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/candidates/SendInterviewInvitationModal.tsx > *:
        reason: >-
          HTML content sanitized via DOMPurify.sanitize() before
          dangerouslySetInnerHTML.
        expires: '2027-01-14T00:00:00.000Z'
    - src/components/settings/AiApiKeysTab.tsx > *:
        reason: >-
          @hello-pangea/dnd library props spread. Controlled by library, not
          user input.
        expires: '2027-01-14T00:00:00.000Z'
    - public/clear-sw.html > *:
        reason: >-
          Static HTML page displaying error messages. No user input flows into
          innerHTML.
        expires: '2027-01-14T00:00:00.000Z'
  SNYK-JS-CLEARTEXT:
    - server.js > *:
        reason: >-
          Local development server. Production uses HTTPS via reverse proxy
          (nginx/traefik).
        expires: '2027-01-14T00:00:00.000Z'
    - scripts/process-upload-queue.cjs > *:
        reason: >-
          Internal queue processor connecting to localhost. Not exposed
          externally.
        expires: '2027-01-14T00:00:00.000Z'
