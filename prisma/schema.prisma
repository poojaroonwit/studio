  updatedAt         DateTime                    @updatedAt
  candidate         Candidate                   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  evaluator         User                        @relation(fields: [evaluatorId], references: [id], onDelete: Cascade)
  position          Position?                   @relation(fields: [positionId], references: [id])
  expertiseScores   CandidateExpertiseScore[]
  personalityScores CandidatePersonalityScore[]

  @@index([candidateId])
  @@index([positionId])
  @@index([evaluatorId])
  @@index([status])
  @@index([createdAt])
}

/// CandidateEvaluationLink - Secure links for external candidate evaluation
model CandidateEvaluationLink {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Reference to candidate
  candidateId String   @db.Uuid
  /// Secure access token
  token       String   @unique
  /// Token expiration timestamp
  expiresAt   DateTime
  /// User who created the link
  createdById String   @db.Uuid
  /// Whether login is required to access
  requireLogin Boolean  @default(true)
  /// Link revocation timestamp
  revokedAt   DateTime?
  /// Record creation timestamp
  createdAt   DateTime @default(now())
  /// Last update timestamp
  updatedAt   DateTime @updatedAt

  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([expiresAt])
}

/// CandidateExpertiseScore - Recorded scores for expertise skills
model CandidateExpertiseScore {
  /// Unique identifier
  id           String              @id @default(uuid()) @db.Uuid
  /// Reference to evaluation
  evaluationId String              @db.Uuid
  /// Reference to skill
  skillId      String              @db.Uuid
  /// Score value
  score        Int
  /// Optional notes on score
  notes        String?
  /// Record creation timestamp
  createdAt    DateTime            @default(now())
  /// Last update timestamp
  updatedAt    DateTime            @updatedAt
  evaluation   CandidateEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  skill        ExpertiseSkill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, skillId])
  @@index([evaluationId])
  @@index([skillId])
}

/// CandidatePersonalityScore - Recorded scores for personality traits
model CandidatePersonalityScore {
  /// Unique identifier
  id           String              @id @default(uuid()) @db.Uuid
  /// Reference to evaluation
  evaluationId String              @db.Uuid
  /// Reference to personality trait
  traitId      String              @db.Uuid
  /// Score value
  score        Int
  /// Optional notes on score
  notes        String?
  /// Record creation timestamp
  createdAt    DateTime            @default(now())
  /// Last update timestamp
  updatedAt    DateTime            @updatedAt
  evaluation   CandidateEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  trait        PersonalityTrait    @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, traitId])
  @@index([evaluationId])
  @@index([traitId])
}

/// User Session - tracks active sessions for single-device login enforcement
model UserSession {
  /// Unique identifier
  id             String   @id @default(uuid()) @db.Uuid
  /// Reference to user
  userId         String   @map("user_id") @db.Uuid
  /// Unique session token
  sessionToken   String   @unique @map("session_token")
  /// Device information string
  deviceInfo     String?  @map("device_info")
  /// Client IP address
  ipAddress      String?  @map("ip_address")
  /// Client user agent
  userAgent      String?  @map("user_agent")
  /// Whether session is active
  isActive       Boolean  @default(true) @map("is_active")
  /// Session creation timestamp
  createdAt      DateTime @default(now()) @map("created_at")
  /// Session expiration timestamp
  expiresAt      DateTime @map("expires_at")
  /// Last activity timestamp
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  
  user           User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([expiresAt])
}
