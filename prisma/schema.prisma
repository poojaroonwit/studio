  companyId        String?   @map("company_id") @db.Uuid
  assignedToUserId String?   @map("assigned_to_user_id") @db.Uuid
  category         String
  subject          String
  description      String
  status           String    @default("submitted")
  priority         String    @default("normal")
  metadata         Json      @default("{}")
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([assignedToUserId, status], map: "support_assignee_status_idx")
  @@index([companyId, status], map: "support_company_status_idx")
  @@index([companyId, updatedAt(sort: Desc)], map: "support_company_updated_idx")
  @@index([requesterUserId, updatedAt(sort: Desc)], map: "support_requester_updated_idx")
