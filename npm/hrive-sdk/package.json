{
  "name": "hrive-sdk",
  "version": "1.0.0",
  "description": "Dependency-free TypeScript SDK for the Hrive public API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poojaroonwit/studio.git",
    "directory": "npm/hrive-sdk"
  },
  "homepage": "https://github.com/poojaroonwit/studio#readme",
  "bugs": "https://github.com/poojaroonwit/studio/issues",
  "keywords": [
    "hrive",
    "hr",
    "recruitment",
    "sdk",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && vite build --config vite.config.ts && tsc -p tsconfig.types.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "vite": "^7.3.0"
  }
}
