{
  "name": "fitscan",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File ./node_modules/.bin/cross-env.ps1 NEXT_TELEMETRY_DISABLED=1 next dev -p 8021",
    "dev:with-processor": "concurrently \"npm run dev\" \"npm run processor\"",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "prebuild": "echo Build started",
    "build": "next build --no-lint",
    "build:fast": "powershell -ExecutionPolicy Bypass -File ./node_modules/.bin/cross-env.ps1 NEXT_TELEMETRY_DISABLED=1 next build --no-lint --no-mangling",
    "typecheck": "tsc --noEmit",
    "postbuild": "echo Build finished",
    "start": "next start -p 8021",
    "start:with-processor": "concurrently \"npm run start\" \"npm run processor\" \"npm run health-check\"",
    "lint": "next lint",
    "processor": "node scripts/process-upload-queue.cjs",
    "processor:pm2": "pm2 start ecosystem.config.js",
    "processor:pm2:stop": "pm2 stop upload-queue-processor",
    "processor:pm2:restart": "pm2 restart upload-queue-processor",
    "processor:pm2:logs": "pm2 logs upload-queue-processor",
    "health-check": "node scripts/health-check.cjs",
    "health-check:docker": "node scripts/health-check-docker.cjs",
    "health-check:pm2": "pm2 start ecosystem.config.js --only health-check",
    "start:production": "node scripts/start-production.cjs",
    "check-webhook": "node scripts/check-webhook-settings.js",
    "check-504": "node scripts/check-504-errors.js",
    "check-duplicates": "node scripts/check-duplicate-processing.js",
    "diagnose-webhook": "node scripts/diagnose-webhook-conflict.js",
    "disable-problematic-webhooks": "node scripts/disable-problematic-webhooks.js",
    "fix-webhook": "node scripts/fix-webhook-config.js",
    "mock-webhook": "node scripts/mock-webhook-server.cjs",
    "clean": "rimraf dist src/**/*.js src/**/*.jsx prisma/seed.js tailwind.config.js",
    "optimize": "echo Optimization script not available",
    "db:migrate": "node scripts/auto-migrate.cjs",
    "db:migrate:force": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:skip": "node scripts/migrate-conditionally.cjs --skip",
    "db:migrate:ps": "powershell -ExecutionPolicy Bypass -File scripts/migrate-conditionally.ps1",
    "db:migrate:ps:force": "powershell -ExecutionPolicy Bypass -File scripts/migrate-conditionally.ps1 -Force",
    "db:validate": "node scripts/migration-validator.cjs",
    "db:validate:force": "node scripts/migration-validator.cjs --force",
    "db:validate:skip-schema": "node scripts/migration-validator.cjs --skip-schema",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:auto": "node scripts/auto-migrate.cjs",
    "db:fix-schema": "node scripts/fix-schema-sync.cjs",
    "db:setup": "node scripts/setup-db-with-postgres-user.js",
    "db:setup:ps": "powershell -ExecutionPolicy Bypass -File scripts/setup-db-with-postgres-user.ps1",
    "setup:local": "node scripts/setup-local-dev.js",
    "db:check": "node scripts/check-database-schema.js",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:create-admin": "node scripts/create-admin-user.js",
    "build:processor": "echo 'Processor build skipped - auto-triggering is now built into the upload API'",
    "seed:upload-queue": "node scripts/seed-upload-queue.js",
    "start:docker": "docker-compose up -d",
    "start:docker:ps": "powershell -ExecutionPolicy Bypass -File scripts/start-app.ps1",
    "stop:docker": "docker-compose down",
    "logs:docker": "docker-compose logs -f",
    "migrate:merge-field-codes": "node scripts/migrate-merge-field-codes.cjs",
    "add-toeic-field": "node scripts/add-toeic-custom-field.cjs",
    "init-ai-prompt": "node scripts/init-ai-power-search-prompt.cjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
