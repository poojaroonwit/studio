# Build-specific environment variables for Docker builds
# Copy this to .env.build and use it in your Portainer deployment

# Build optimization
NODE_OPTIONS=--max-old-space-size=4096
NEXT_TELEMETRY_DISABLED=1
NODE_ENV=production

# Docker build settings
BUILDKIT_INLINE_CACHE=1
DOCKER_BUILDKIT=1

# Database configuration (required for build)
DATABASE_URL=postgresql://postgres:password@postgres:5432/fitscan
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=fitscan

# MinIO configuration (required for build)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=studio-production
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9001
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://localhost:9001

# NextAuth configuration (required for build)
NEXTAUTH_URL=http://localhost:8021
NEXTAUTH_SECRET=your-secret-key-here

# Application configuration
APP_TIMEZONE=Asia/Bangkok
PRODUCTION_HOST=http://localhost:8021

# Processor configuration
PROCESSOR_API_KEY=dev-key
PROCESSOR_URL=http://localhost:8021
PROCESSOR_PORT=8021

# Database connection settings
DATABASE_CONNECTION_TIMEOUT=1800000
DATABASE_MAX_CONNECTIONS=1000
DATABASE_IDLE_TIMEOUT=30000
DATABASE_SSL=false

# Skip seeding during build
SKIP_SEED=true

# Azure AD (optional - set if using Azure AD SSO)
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
# NEXT_PUBLIC_AZURE_AD_CLIENT_ID=
# NEXT_PUBLIC_AZURE_AD_TENANT_ID=

# Webhook configuration (optional)
# RESUME_PROCESSING_WEBHOOK_URL=
# RESUME_PROCESSING_WEBHOOK_TOKEN=

# Google API (optional)
# GOOGLE_API_KEY=
