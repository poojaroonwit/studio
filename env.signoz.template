# SigNoz Docker Compose Environment Variables
# Copy this file to .env.signoz and update with your values
# 
# Usage:
#   cp env.signoz.template .env.signoz
#   # Edit .env.signoz with your values
#   docker-compose -f docker-compose.signoz.yml up -d

# ClickHouse Database Password
# Default: signoz
CLICKHOUSE_PASSWORD=signoz

# Prometheus Endpoint (REQUIRED)
# Set this to your existing Prometheus instance
# Examples:
#   - If Prometheus is on host machine: http://host.docker.internal:9090
#   - If Prometheus is in Docker (same network): http://prometheus-container-name:9090
#   - If Prometheus is on different network: http://192.168.1.100:9090
#   - If Prometheus is on same Docker network: http://your-prometheus-container:9090
PROMETHEUS_QUERY_ENDPOINT=http://host.docker.internal:9090

# =================================================================
# CORS Configuration (Security)
# =================================================================
# Comma-separated list of allowed origins for CORS requests
# Supports wildcard patterns like *.qsncc.com (all subdomains)
# Example: http://localhost:8021,*.qsncc.com
# Note: *.qsncc.com is automatically allowed for all subdomains
CORS_ALLOWED_ORIGINS=http://localhost:8021,*.qsncc.com

# =================================================================
# Database SSL Configuration (Security)
# =================================================================
# SECURITY: Set to true to validate SSL certificates (recommended)
# Set to false only if using self-signed certificates
DATABASE_SSL_REJECT_UNAUTHORIZED=true  # Default: true (secure). Set to false only for self-signed certs

