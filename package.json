{
  "name": "hri",
  "version": "1.2.6",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-dev.cjs --turbo",
    "dev:turbo": "npm run dev",
    "dev:fast": "node scripts/start-dev.cjs --turbo --fast",
    "dev:webpack": "node scripts/start-dev.cjs",
    "dev:custom": "node server.js",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --quiet",
    "lint:strict": "eslint src --max-warnings=0",
    "type-check": "tsc --noEmit",
    "typecheck": "npm run type-check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check:architecture": "node scripts/check-frontend-architecture.mjs",
    "check": "npm run check:architecture && npm run type-check && npm run lint && npm run test:run",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js",
    "sync-version": "node scripts/sync-version.js",
    "fix:capitalization": "node scripts/fix-applicant-capitalization.js",
    "fix:capitalization:dry-run": "node scripts/fix-applicant-capitalization.js --dry-run",
    "schema:validate": "prisma validate --schema=prisma/schema.prisma",
    "schema:drift": "node scripts/check-prisma-schema-drift.cjs",
    "migrate:status": "prisma migrate status --schema=prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "migrate:repair": "node scripts/skip-failed-migrations.js",
    "db:comments": "tsx scripts/apply-db-comments.ts",
    "seed:hr": "tsx prisma/seed-hr.ts",
    "seed:shift": "tsx prisma/seed-shift-attendance.ts",
    "seed:ess": "tsx prisma/seed-ess.ts",
    "seed:leaves": "tsx prisma/seed-leaves.ts",
    "seed:performance": "tsx prisma/seed-performance.ts",
    "seed:appraisal": "tsx prisma/seed-appraisal.ts",
    "report:position-organization-links": "tsx scripts/report-unresolved-position-organization-links.ts",
    "seed:payroll": "tsx prisma/seed-payroll.ts",
    "screening:processor": "node scripts/process-screening-queue.cjs",
    "audit:submit-assurance": "node scripts/submit-audit-assurance.mjs",
    "audit:verify-database": "node scripts/verify-audit-database.mjs",
    "audit:localization": "node scripts/audit-localization.cjs",
    "audit:localization:summary": "node scripts/audit-localization.cjs --quiet",
    "localization:export-appkit": "node scripts/audit-localization.cjs --quiet --appkit-payload=.appkit-localization-audit.json"
