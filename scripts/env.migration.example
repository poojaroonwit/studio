# MinIO Migration Configuration
# Copy this file to .env.migration and fill in your values
# Usage: python migrate_minio.py --env-file .env.migration

# ======================================
# SOURCE CONNECTION (Old MinIO Server)
# ======================================
SOURCE_MINIO_ENDPOINT=10.0.10.57:8621
SOURCE_MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
SOURCE_MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
SOURCE_MINIO_BUCKET=studio-dev
SOURCE_MINIO_USE_SSL=false

# ======================================
# DESTINATION CONNECTION (New MinIO Server)
# ======================================
DEST_MINIO_ENDPOINT=new-server:9000
DEST_MINIO_ACCESS_KEY=newadmin
DEST_MINIO_SECRET_KEY=newsecret
DEST_MINIO_BUCKET=studio-prod
DEST_MINIO_USE_SSL=false
