# Staging Environment Configuration
# Copy this file to .env.staging and fill in your actual values

# Staging Server Configuration
STAGING_HOST=staging.example.com
STAGING_USER=deploy
STAGING_PATH=/var/www/studio-5

# Application Configuration
NODE_ENV=staging
APP_PORT=8021

# Database Configuration
# For local development, use localhost:8521
# For staging with Docker, use staging-db:5432
DATABASE_URL=postgresql://postgres:password@localhost:8521/studio5_staging
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=studio5_staging
POSTGRES_HOST=localhost
POSTGRES_PORT=8521

# Staging Docker settings (uncomment for staging deployment)
# DATABASE_URL=postgresql://postgres:password@staging-db:5432/studio5_staging
# POSTGRES_HOST=staging-db
# POSTGRES_PORT=5432

# MinIO Configuration
# For local development, use localhost
# For staging with Docker, use minio
MINIO_ENDPOINT=localhost
MINIO_PORT=8621
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=studio5-staging
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:8721
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Staging Docker settings (uncomment for staging deployment)
# MINIO_ENDPOINT=minio
# MINIO_PORT=9000
# MINIO_PUBLIC_BASE_URL=http://staging.example.com:9847

# Redis Configuration
REDIS_URL=redis://redis:6379

# Authentication Configuration
NEXTAUTH_URL=https://staging.studio-5.com
NEXTAUTH_SECRET=your-staging-secret-key

# Azure AD Configuration (Optional)
AZURE_AD_CLIENT_ID=your-azure-client-id
AZURE_AD_CLIENT_SECRET=your-azure-client-secret
AZURE_AD_TENANT_ID=your-azure-tenant-id
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-azure-client-id
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-azure-tenant-id

# Webhook Configuration
RESUME_PROCESSING_WEBHOOK_URL=https://staging.studio-5.com/api/webhook/resume
RESUME_PROCESSING_WEBHOOK_TOKEN=your-webhook-token
GENERAL_PDF_WEBHOOK_URL=https://staging.studio-5.com/api/webhook/pdf
GENERAL_PDF_WEBHOOK_TOKEN=your-pdf-webhook-token
PROCESSOR_API_KEY=your-processor-api-key

# External API Keys
GOOGLE_API_KEY=your-google-api-key
NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=your-google-fonts-api-key

# WebSocket Configuration
WS_QUEUE_BRIDGE_PORT=9851
WS_ALLOWED_ORIGINS=https://staging.studio-5.com
NEXT_PUBLIC_WS_QUEUE_BRIDGE_URL=ws://staging.example.com:9851

# Public MinIO Configuration
NEXT_PUBLIC_MINIO_BUCKET=studio5-staging
NEXT_PUBLIC_MINIO_PUBLIC_BASE_URL=http://staging.example.com:9847
NEXT_PUBLIC_MINIO_URL=http://staging.example.com:9847
NEXT_PUBLIC_MINIO_BUCKET_NAME=studio5-staging

# Internal Network Configuration
INTERNAL_SERVER_IP=172.20.21.10
INTERNAL_DOMAIN=staging.internal

# Processor Configuration
PROCESSOR_INTERVAL_MS=5000
LOG_INTERVAL_MS=30000

# Port Configuration
APP_PORT=8021
POSTGRES_PORT=8521
MINIO_API_PORT=8621
MINIO_CONSOLE_PORT=8721
REDIS_EXTERNAL_PORT=8921
PROCESSOR_PORT=8821 