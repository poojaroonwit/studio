{
  "name": "fitscan",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -Command \"$env:NEXT_TELEMETRY_DISABLED='1'; $env:ENABLE_PROD_OPTIMIZATIONS='1'; next dev -p 8021 --turbo\"",
    "dev:custom": "powershell -ExecutionPolicy Bypass -Command \"$env:NEXT_TELEMETRY_DISABLED='1'; node server.js\"",
    "dev:with-processor": "concurrently \"npm run dev\" \"npm run processor\"",
    "prebuild": "echo Build started",
    "build": "next build",
    "build:fast": "powershell -ExecutionPolicy Bypass -Command \"$env:FAST_BUILD='true'; $env:SKIP_TYPE_CHECK='true'; $env:NEXT_TELEMETRY_DISABLED='1'; $env:NODE_OPTIONS='--max-old-space-size=4096'; next build\"",
    "build:ci": "powershell -ExecutionPolicy Bypass -Command \"$env:CI='true'; $env:NEXT_TELEMETRY_DISABLED='1'; next build\"",
    "typecheck": "tsc --noEmit",
    "postbuild": "echo Build finished",
    "start": "node server.js",
    "start:with-processor": "concurrently \"npm run start\" \"npm run processor\"",
    "start:local": "node start-local.js",
    "start:local:with-processor": "node start-local.js --with-processor",
    "lint": "next lint",
    "processor": "powershell -ExecutionPolicy Bypass -Command \"$env:NODE_ENV='development'; node scripts/process-upload-queue.cjs\"",
    "processor:pm2": "pm2 start ecosystem.config.js",
    "processor:pm2:stop": "pm2 stop upload-queue-processor",
    "processor:pm2:restart": "pm2 restart upload-queue-processor",
    "processor:pm2:logs": "pm2 logs upload-queue-processor",
    "start:production": "node scripts/start-production.cjs",
    "clean": "rimraf dist src/**/*.js src/**/*.jsx prisma/seed.js tailwind.config.js",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:dev": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:check": "prisma db push --schema=prisma/schema.prisma --accept-data-loss",
    "db:reset": "prisma migrate reset --force",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "setup:local": "node scripts/setup-local-dev.js",
    "seed:demo-data": "npx tsx scripts/seed-demo-data.ts",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:migrate:seed": "bash scripts/run-migrations-and-seed.sh",
    "db:create-admin": "node scripts/create-admin-user.js",
    "build:processor": "echo 'Processor build skipped - auto-triggering is now built into the upload API'",
    "seed:upload-queue": "node scripts/seed-upload-queue.js",
    "start:docker": "docker-compose up -d",
    "stop:docker": "docker-compose down",
    "logs:docker": "docker-compose logs -f",
    "fix:stages": "node scripts/fix-stage-mismatches.js",
    "fix:stages:dry-run": "node scripts/fix-stage-mismatches.js --dry-run",
    "fix:candidate-status": "node scripts/fix-candidate-status-uuid.js",
    "fix:status-rename": "node scripts/update-components-to-statusId.js",
    "migrations:skip-failed": "node scripts/skip-failed-migrations.js",
    "migrations:skip-failed:dry-run": "node scripts/skip-failed-migrations.js --dry-run",
    "settings:list": "node scripts/manage-system-settings.js list",
    "settings:get": "node scripts/manage-system-settings.js get",
    "settings:set": "node scripts/manage-system-settings.js set",
    "settings:enable-basic-auth": "node scripts/manage-system-settings.js enable-basic-auth",
    "settings:disable-basic-auth": "node scripts/manage-system-settings.js disable-basic-auth",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.js"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elastic/elasticsearch": "^9.2.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/client": "^6.11.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/nextjs": "^10.24.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tiptap/react": "^2.26.1",
    "@tiptap/starter-kit": "^2.26.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^5.6.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.2.1",
    "form-data": "^4.0.4",
    "formidable": "^3.5.4",
    "isomorphic-dompurify": "^2.28.0",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.475.0",
    "minio": "^8.0.5",
    "next": "^15.5.2",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.9.8",
    "pg": "^8.12.0",
    "prisma": "^6.11.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "recharts": "^3.1.2",
    "swagger-ui-react": "^5.28.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "uuid": "^10.0.0",
    "validator": "^13.15.15",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/date-fns": "^2.5.3",
    "@types/node": "^24.0.10",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/swagger-ui-react": "^5.18.0",
    "@types/validator": "^13.15.3",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
