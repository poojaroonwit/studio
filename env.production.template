# =================================================================
# Production Environment Configuration
# =================================================================
# SECURITY WARNING: This is a template file. Before deploying:
# 1. Replace ALL placeholder values (CHANGE_THIS_*, your-*, localhost)
# 2. Generate secure secrets using: openssl rand -base64 32
# 3. Use strong, unique passwords for all services
# 4. Enable SSL/TLS for all database and storage connections
# 5. Review and configure CORS_ALLOWED_ORIGINS appropriately
# 6. Never commit actual production values to version control
# =================================================================

NODE_ENV=production
APP_PORT=8021
NEXT_TELEMETRY_DISABLED=1
APP_TIMEZONE=Asia/Bangkok

# Database Configuration (PostgreSQL)
# For local development, use localhost:8521
# For production with Docker, use postgres:5432
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
POSTGRES_USER=fitscan
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=fitscan
POSTGRES_HOST=ncc-pgsql-data-product.qsncc.com
POSTGRES_PORT=5433

# Production Docker settings (uncomment for production deployment)
# DATABASE_URL=postgresql://USER:PASSWORD@postgres:5432/DATABASE
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# Object Storage Configuration (S3-compatible)
# Works with Railway buckets, AWS S3, MinIO, and other S3-compatible providers.
# Legacy MINIO_* names still work, but STORAGE_* is preferred for new deployments.
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=https://CHANGE_THIS_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY_ID=CHANGE_THIS_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_THIS_STORAGE_SECRET_KEY
STORAGE_BUCKET=fitscan
STORAGE_PUBLIC_BASE_URL=https://CHANGE_THIS_STORAGE_PUBLIC_BASE_URL

# Production Docker MinIO settings (uncomment if running bundled MinIO)
# MINIO_ROOT_USER=fitscan-user
# MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# STORAGE_PROVIDER=minio
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_PUBLIC_BASE_URL=https://CHANGE_THIS_PUBLIC_MINIO_URL
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# SECURITY: File access configuration
# ALLOW_PUBLIC_FILES=false  # NEVER set to true in production - security risk!
# USE_SIGNED_URLS_IN_WEBHOOKS=true  # Use provider signed URLs in webhook payloads.

# Authentication Configuration
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_THIS_GENERATE_SECURE_SECRET_USING_OPENSSL
NEXTAUTH_URL=CHANGE_THIS_YOUR_DOMAIN_OR_IP

# =================================================================
# CORS Configuration (Security)
# =================================================================
# Comma-separated list of allowed origins for CORS requests
# Supports wildcard patterns like *.qsncc.com (all subdomains)
# Example: https://yourdomain.com,https://app.yourdomain.com,*.qsncc.com
# Note: *.qsncc.com is automatically allowed for all subdomains
# SECURITY: Only include trusted domains to prevent unauthorized access
# 
# Azure AD SSO Note: Azure AD domains are automatically added when Azure AD is configured.
# Azure AD SSO typically uses redirects (not CORS), so explicit CORS configuration
# is usually not required for SSO. However, Azure AD domains are automatically
# allowed if AZURE_AD_CLIENT_ID, AZURE_AD_CLIENT_SECRET, and AZURE_AD_TENANT_ID are set.
CORS_ALLOWED_ORIGINS=CHANGE_THIS_YOUR_ALLOWED_ORIGINS,*.qsncc.com

# Azure AD Configuration (Optional - for SSO)
AZURE_AD_CLIENT_ID=your-azure-ad-client-id
AZURE_AD_CLIENT_SECRET=your-azure-ad-client-secret
AZURE_AD_TENANT_ID=your-azure-ad-tenant-id
NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your-azure-ad-client-id
NEXT_PUBLIC_AZURE_AD_TENANT_ID=your-azure-ad-tenant-id

# External API Keys
GOOGLE_API_KEY=your-google-api-key
# NEXT_PUBLIC_GOOGLE_FONTS_API_KEY is not used in the application

# Webhook Configuration
RESUME_PROCESSING_WEBHOOK_URL=https://ncc-dify.qsncc.com/v1/workflows/run
RESUME_PROCESSING_WEBHOOK_TOKEN=your-resume-processing-webhook-token
GENERAL_PDF_WEBHOOK_URL=https://ncc-dify.qsncc.com/v1/workflows/run
GENERAL_PDF_WEBHOOK_TOKEN=your-general-pdf-webhook-token
RESUME_PROCESSING_WEBHOOK_TIMEOUT=1800
WEBHOOK_CONNECTION_TIMEOUT=900
PROCESSOR_API_KEY=your-processor-api-key
PROCESSOR_URL=https://ncc-dify.qsncc.com/v1/workflows/run
UPLOAD_QUEUE_PROCESS_URL=http://8021_fitscan_app:8021/api/upload-queue/process
# Upload Queue Processor Configuration - FIXED TIMING
PROCESSOR_INTERVAL_MS=5000           # Fixed interval: 5000ms (5 seconds) - no dynamic adjustments
MAX_CONCURRENT_PROCESSORS=1          # Default to 1 for connection optimization
LOG_INTERVAL_MS=5000                 # Status logging interval: 5000ms (5 seconds)

# Real-time Configuration (SSE)
# SSE is used for real-time updates instead of WebSocket
# No additional configuration needed for SSE

# Production Host Configuration
PRODUCTION_HOST=http://10.0.10.71:8021
# Note: PRODUCTION_USER and PRODUCTION_PATH are not used in docker-compose


# Build and Optimization Controls
# Leave unset (recommended) to keep production bundles optimized.
# Set to 'true' only for emergency hotfix builds when diagnosing runtime issues.
# DISABLE_OPTIMIZATION=false






# =================================================================
# =================================================================
# OTLP Headers - Only SigNoz API key (JSON format required)
# OTEL_EXPORTER_OTLP_HEADERS={"x-api-key":"your-signoz-api-key"}
