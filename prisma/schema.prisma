  /// Last update timestamp
  updatedAt    DateTime @updatedAt
  users        User[]   @relation("UserUserGroup")

  @@index([isDefault])
  @@index([isSystemRole])
}

/// UserTeam - Teams for organizing users within the organization
model UserTeam {
