# Alternative Dockerfile using Yarn instead of npm
FROM node:18-alpine

WORKDIR /app

# Install Yarn
RUN npm install -g yarn

# Install necessary build tools and dependencies
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git \
    curl \
    wget

# Copy package files first for better caching
COPY package*.json ./
COPY yarn.lock* ./

# Install dependencies using Yarn
RUN yarn install --frozen-lockfile --production=false --network-timeout 1000000

# Copy source code
COPY . .

# Debug: check if src/lib/db.ts exists
RUN ls -l src/lib/db.ts || (echo 'src/lib/db.ts not found!' && exit 1)

# Generate Prisma client
RUN npx prisma generate

# Build the application with increased memory
ENV NODE_OPTIONS="--max-old-space-size=4096"
RUN yarn build

# Make entrypoint scripts executable
RUN chmod +x ./entrypoint.sh
RUN chmod +x ./entrypoint-processor.sh

EXPOSE 8021

# Start the application using the entrypoint script
CMD ["/bin/sh", "/app/entrypoint.sh"]
