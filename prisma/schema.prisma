generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                    @id @default(uuid()) @db.Uuid
  name                 String
  email                String                    @unique
  password             String
  role                 String
  avatarUrl            String?
  image                String?
  dataAiHint           String?
  authenticationMethod String?                   @default("basic") @map("authentication_method")
  forcePasswordChange  Boolean                   @default(false) @map("force_password_change")
  emailVerified        DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  azure_oid            String?                   @unique
  personalColor        String?                   @default("#3B82F6") @map("personal_color")
  module_permissions   String[]                  @default([])
  accounts             Account[]
  attachments          Attachment[]              @relation("UserAttachments")
  candidates           Candidate[]               @relation("RecruiterCandidates")
  candidateComments    CandidateComment[]        @relation("UserComments")
  Dashboard            Dashboard[]
  DashboardShare       DashboardShare[]
  logEntries           LogEntry[]                @relation("UserLogEntries")
  notifications        Notification[]
  positions            Position[]                @relation("RecruiterPositions")
  transitionRecords    TransitionRecord[]        @relation("ActingUserTransitions")
  userPreferences      UserUIDisplayPreference[]
  userGroups           User_UserGroup[]
  userTeams            User_UserTeam[]
  uploadQueue          UploadQueue[]             @relation("UserUploadQueue")
  warningConfigurations WarningConfiguration[]   @relation("UserWarningConfigurations")
  sharedWarningConfigurations WarningConfigurationShare[]

  @@index([email])
  @@index([role])
  @@index([authenticationMethod])
}

model Position {
  id                String             @id @default(uuid()) @db.Uuid
  title             String
  department        String
  description       String?
  matchCriteria     String?
  isOpen            Boolean            @default(true)
  positionLevel     String?
  positionAttribute String?
  gradeId           String?            @db.Uuid
  hiringDate        DateTime?
  recruiterId       String?            @db.Uuid
  customAttributes  Json?              @default("{}")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  candidates        Candidate[]
  headcounts        Headcount[]        @relation("PositionHeadcount")
  recruiter         User?              @relation("RecruiterPositions", fields: [recruiterId], references: [id])
  grade             Grade?             @relation(fields: [gradeId], references: [id])
  transitionRecords TransitionRecord[]
  warnings          Warning[] @relation("WarningPosition")

  @@index([title])
  @@index([department])
  @@index([isOpen])
  @@index([recruiterId])
  @@index([gradeId])
  @@index([hiringDate])
}

model Candidate {
  id                      String             @id @default(uuid()) @db.Uuid
  name                    String
  email                   String
  phone                   String?
  positionId              String?            @db.Uuid
  recruiterId             String?            @db.Uuid
  fitScore                Float?             @default(0)
  status                  String             @default("Applied")
  applicationDate         DateTime           @default(now())
  parsedData              Json?
  customAttributes        Json?              @default("{}")
  resumePath              String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  avatarUrl               String?
  dataAiHint              String?
  assignmentJustification String?
  educationData           Json?              @default("[]")
  experienceData          Json?              @default("[]")
  sourceId                String?            @db.Uuid
  subSource               String?
  attachments             Attachment[]
  position                Position?          @relation(fields: [positionId], references: [id])
  recruiter               User?              @relation("RecruiterCandidates", fields: [recruiterId], references: [id])
  source                  CandidateSource?   @relation(fields: [sourceId], references: [id])
  candidateComments       CandidateComment[]
  headcounts              Headcount[]        @relation("CandidateHeadcount")
  jobMatches              JobMatch[]
  transitionRecords       TransitionRecord[]
  warnings                Warning[] @relation("WarningCandidate")

  @@index([email])
  @@index([status])
  @@index([positionId])
  @@index([recruiterId])
  @@index([applicationDate])
  @@index([fitScore])
  @@index([sourceId])
}

model RecruitmentStage {
  id             String  @id @default(uuid()) @db.Uuid
  name           String  @unique
  description    String?
  isSystem       Boolean @map("is_system")
  sortOrder      Int     @map("sort_order")
  color_complete String?
  color_badge    String?

  @@index([sortOrder])
  @@index([isSystem])
}

model TransitionRecord {
  id           String    @id @default(uuid()) @db.Uuid
  candidateId  String    @db.Uuid
  positionId   String?   @db.Uuid
  date         DateTime  @default(now())
  stage        String
  notes        String?
  actingUserId String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  actingUser   User?     @relation("ActingUserTransitions", fields: [actingUserId], references: [id])
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position     Position? @relation(fields: [positionId], references: [id])

  @@index([candidateId])
  @@index([actingUserId])
  @@index([date])
  @@index([stage])
  @@index([positionId])
}

model LogEntry {
  id           String   @id @default(uuid()) @db.Uuid
  timestamp    DateTime @default(now())
  level        String
  message      String
  source       String?
  actingUserId String?  @db.Uuid
  details      Json?
  createdAt    DateTime @default(now())
  actingUser   User?    @relation("UserLogEntries", fields: [actingUserId], references: [id])

  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@index([actingUserId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  level        String
  message      String
  source       String?
  actingUserId String?  @db.Uuid
  details      Json?
  timestamp    DateTime @default(now())
  user_id      String?  @db.Uuid
  action       String?
  entity       String?
  entity_id    String?  @db.Uuid

  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@index([actingUserId])
  @@index([user_id])
}

model UserGroup {
  id           String           @id @default(uuid()) @db.Uuid
  name         String           @unique
  description  String?
  permissions  String[]         @default([])
  isDefault    Boolean          @default(false) @map("is_default")
  isSystemRole Boolean          @default(false) @map("is_system_role")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        User_UserGroup[]

  @@index([isDefault])
  @@index([isSystemRole])
}

model User_UserGroup {
  userId  String    @db.Uuid
  groupId String    @db.Uuid
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model UserTeam {
  id          String          @id @default(uuid()) @db.Uuid
  name        String          @unique
  description String?
  color       String?         @default("#3B82F6")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now())
  members     User_UserTeam[]

  @@index([isActive])
}

model User_UserTeam {
  userId String   @db.Uuid
  teamId String   @db.Uuid
  team   UserTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([userId])
  @@index([teamId])
}

model SystemSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([updatedAt])
}

model CustomFieldDefinition {
  id                        String              @id @default(uuid()) @db.Uuid
  modelName                 String              @map("model_name")
  fieldKey                  String              @map("field_key")
  label                     String
  fieldType                 String              @map("field_type")
  options                   Json?
  isRequired                Boolean             @default(false) @map("is_required")
  sortOrder                 Int                 @default(0) @map("sort_order")
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @default(now())
  allowCustomOptions        Boolean             @default(false) @map("allow_custom_options")
  attributeCode             String?             @map("attribute_code")
  attributeLabel            String?             @map("attribute_label")
  editRoles                 String[]            @default([]) @map("edit_roles")
  showInCandidateDetail     Boolean             @default(false) @map("show_in_candidate_detail")
  showInFilter              Boolean             @default(false) @map("show_in_filter")
  showInFullCandidateDetail Boolean             @default(false) @map("show_in_full_candidate_detail")
  showInPositionSettings    Boolean             @default(false) @map("show_in_position_settings")
  showInTaskBoardFilter     Boolean             @default(false) @map("show_in_task_board_filter")
  viewRoles                 String[]            @default([]) @map("view_roles")
  fieldCode                 String              @map("field_code")
  showInHeadcountDetail     Boolean             @default(false) @map("show_in_headcount_detail")
  customFieldOptions        CustomFieldOption[]

  @@unique([modelName, fieldKey])
  @@unique([modelName, fieldCode])
  @@index([modelName])
  @@index([sortOrder])
  @@index([viewRoles])
  @@index([editRoles])
}

model CustomFieldOption {
  id                      String                @id @default(uuid()) @db.Uuid
  customFieldDefinitionId String                @map("custom_field_definition_id") @db.Uuid
  value                   String
  label                   String
  color                   String?               @default("#3B82F6")
  sortOrder               Int                   @default(0) @map("sort_order")
  isActive                Boolean               @default(true) @map("is_active")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now())
  customFieldDefinition   CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([customFieldDefinitionId, value])
  @@index([customFieldDefinitionId])
  @@index([sortOrder])
  @@index([isActive])
}

model JobMatch {
  id                    String    @id @default(uuid()) @db.Uuid
  candidateId           String    @db.Uuid
  jobId                 String?   @db.Uuid
  jobTitle              String?   @map("jobTitle")
  fitScore              Float?    @map("fitScore")
  matchReasons          String[]  @map("matchReasons")
  jobDescriptionSummary String?   @map("job_description_summary")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([fitScore])
}

model UploadQueue {
  id             String    @id @default(uuid()) @db.Uuid
  fileName       String    @map("file_name")
  fileSize       BigInt    @map("file_size")
  status         String
  error          String?
  errorDetails   String?   @map("error_details")
  source         String?
  uploadDate     DateTime  @default(now()) @map("upload_date")
  completedDate  DateTime? @map("completed_date")
  uploadId       String?   @map("upload_id")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @default(now()) @map("updated_at")
  filePath       String    @map("file_path")
  webhookPayload Json?     @map("webhook_payload")
  positionId     String?   @map("position_id") @db.Uuid
  processDate    DateTime? @map("process_date")
  createdByUser  User?     @relation("UserUploadQueue", fields: [createdBy], references: [id])

  @@unique([filePath, status], name: "unique_file_path_status")
  @@index([status])
  @@index([uploadDate])
  @@index([completedDate])
  @@index([processDate])
  @@index([createdBy])
  @@index([source])
  @@map("upload_queue")
}

model UserUIDisplayPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("userId") @db.Uuid
  modelType    String   @map("model_type")
  attributeKey String   @map("attribute_key")
  uiPreference String   @map("ui_preference")
  customNote   String?  @map("custom_note")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelType, attributeKey])
  @@index([userId])
  @@index([modelType])
  @@index([attributeKey])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model SystemPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  key       String
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model CandidateComment {
  id            String    @id @default(uuid()) @db.Uuid
  candidateId   String    @db.Uuid
  authorId      String    @db.Uuid
  content       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  attachmentIds String[]
  author        User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([authorId])
}

model Attachment {
  id           String     @id @default(uuid()) @db.Uuid
  candidateId  String?    @db.Uuid
  uploadedById String     @db.Uuid
  filePath     String
  fileName     String
  label        String
  isPrimary    Boolean    @default(false)
  uploadedAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  headcountId  String?    @db.Uuid
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  headcount    Headcount? @relation("HeadcountAttachments", fields: [headcountId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("UserAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([headcountId])
  @@index([uploadedById])
  @@index([label])
  @@index([isPrimary])
}

model Webhook {
  id                String              @id @default(uuid()) @db.Uuid
  name              String
  url               String
  method            String
  headers           Json?
  auth_header_name  String?             @map("auth_header_name")
  auth_header_value String?             @map("auth_header_value")
  auth_password     String?             @map("auth_password")
  auth_token        String?             @map("auth_token")
  auth_type         String              @default("none") @map("auth_type")
  auth_username     String?             @map("auth_username")
  createdAt         DateTime            @default(now()) @map("createdAt")
  events            String[]
  is_active         Boolean             @default(true) @map("is_active")
  retry_count       Int                 @default(3) @map("retry_count")
  timeout           Int                 @default(30)
  updatedAt         DateTime            @updatedAt @map("updatedAt")
  body_template     String?             @map("body_template")
  field_mappings    Json?               @map("field_mappings")
  include_metadata  Boolean             @default(true) @map("include_metadata")
  custom_payload    Boolean             @default(false) @map("custom_payload")
  body_configs      WebhookBodyConfig[]
  logs              WebhookLog[]

  @@index([is_active])
  @@index([events])
  @@index([createdAt])
}

model WebhookBodyConfig {
  id             String   @id @default(uuid()) @db.Uuid
  webhook_id     String   @map("webhook_id") @db.Uuid
  event_type     String   @map("event_type")
  body_template  String   @map("body_template")
  field_mappings Json?    @map("field_mappings")
  is_active      Boolean  @default(true) @map("is_active")
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")
  webhook        Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@unique([webhook_id, event_type])
  @@index([webhook_id])
  @@index([event_type])
  @@index([is_active])
}

model WebhookLog {
  id              String   @id @default(uuid()) @db.Uuid
  webhook_id      String   @map("webhook_id") @db.Uuid
  event_type      String   @map("event_type")
  payload         Json
  response_status Int?     @map("response_status")
  response_body   String?  @map("response_body")
  success         Boolean
  error_message   String?  @map("error_message")
  duration_ms     Int      @default(0) @map("duration_ms")
  createdAt       DateTime @default(now()) @map("createdAt")
  webhook         Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id])
  @@index([event_type])
  @@index([success])
  @@index([createdAt])
}

model Dashboard {
  id              String            @id @db.Uuid
  name            String
  description     String?
  userId          String            @db.Uuid
  layout          String            @default("grid")
  theme           String            @default("default")
  isPublic        Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  User            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  DashboardShare  DashboardShare[]
  DashboardWidget DashboardWidget[]

  @@index([createdAt])
  @@index([isPublic])
  @@index([updatedAt])
  @@index([userId])
}

model DashboardShare {
  id          String    @id @db.Uuid
  dashboardId String    @db.Uuid
  userId      String    @db.Uuid
  permission  String    @default("view")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, userId])
  @@index([dashboardId])
  @@index([permission])
  @@index([userId])
}

model DashboardWidget {
  id          String    @id @db.Uuid
  dashboardId String    @db.Uuid
  type        String
  title       String
  config      Json?
  position    Json?
  dataSource  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([dashboardId])
  @@index([type])
}

model SystemPromptCategory {
  id            String         @id @default(uuid()) @db.Uuid
  name          String         @unique
  description   String?
  color         String?        @default("#3B82F6")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  systemPrompts SystemPrompt[]

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
}

model SystemPrompt {
  id          String               @id @default(uuid()) @db.Uuid
  name        String
  description String?
  content     String
  categoryId  String               @db.Uuid
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  category    SystemPromptCategory @relation(fields: [categoryId], references: [id])

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
}

model CandidateSource {
  id             String      @id @default(uuid()) @db.Uuid
  name           String      @unique
  description    String?
  allowSubSource Boolean     @default(false) @map("allow_sub_source")
  sortOrder      Int         @default(0) @map("sort_order")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  logo           String?
  candidates     Candidate[]

  @@index([sortOrder])
  @@index([isActive])
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  title     String
  message   String
  data      Json?    @default("{}")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

model Headcount {
  id             String       @id @default(uuid()) @db.Uuid
  positionId     String       @db.Uuid
  type           String       @default("new")
  status         String       @default("vacant")
  candidateId    String?      @db.Uuid
  onboardingDate DateTime?
  notes          String?
  memoId         String?      @map("memo_id")
  customFields   Json?        @default("{}") @map("custom_fields")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  attachments    Attachment[] @relation("HeadcountAttachments")
  candidate      Candidate?   @relation("CandidateHeadcount", fields: [candidateId], references: [id])
  position       Position     @relation("PositionHeadcount", fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
  @@index([candidateId])
  @@index([type])
  @@index([status])
}

model Grade {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  label       String?   // Display label for the grade
  description String?
  minLevel    Int       @map("min_level")
  maxLevel    Int       @map("max_level")
  slaDays     Int       @map("sla_days")
  color       String?   @default("#3B82F6")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  positions   Position[]

  @@index([minLevel])
  @@index([maxLevel])
  @@index([isActive])
  @@index([sortOrder])
}

model WarningConfiguration {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  entityType  String   @map("entity_type") // 'position', 'candidate', 'headcount', etc.
  field       String   // The field to monitor
  condition   String   // 'overdue', 'empty', 'threshold', 'date_range', etc.
  operator    String   // 'gt', 'lt', 'eq', 'ne', 'contains', 'not_contains', etc.
  value       String?  // The value to compare against
  threshold   Int?     // Numeric threshold for conditions like 'overdue'
  isActive    Boolean  @default(true) @map("is_active")
  severity    String   @default("warning") // 'info', 'warning', 'error', 'critical'
  isPublic    Boolean  @default(false) @map("is_public") // Whether this config is shared with all users
  createdBy   String   @db.Uuid @map("created_by")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  warnings    Warning[]
  createdByUser User   @relation("UserWarningConfigurations", fields: [createdBy], references: [id], onDelete: Cascade)
  sharedWith  WarningConfigurationShare[]

  @@index([entityType])
  @@index([field])
  @@index([isActive])
  @@index([severity])
  @@index([createdBy])
  @@index([isPublic])
}

model Warning {
  id                    String              @id @default(uuid()) @db.Uuid
  configurationId       String              @db.Uuid
  entityType            String              @map("entity_type")
  entityId              String              @db.Uuid @map("entity_id")
  field                 String
  currentValue          String?             @map("current_value")
  expectedValue         String?             @map("expected_value")
  message               String
  severity              String              @default("warning")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  configuration         WarningConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  candidate             Candidate?          @relation("WarningCandidate", fields: [entityId], references: [id], onDelete: Cascade, map: "Warning_candidate_entity_id_fkey")
  position              Position?           @relation("WarningPosition", fields: [entityId], references: [id], onDelete: Cascade, map: "Warning_position_entity_id_fkey")

  @@index([configurationId])
  @@index([entityType])
  @@index([entityId])
  @@index([severity])
  @@index([createdAt])
}

model WarningConfigurationShare {
  id                    String                @id @default(uuid()) @db.Uuid
  configurationId       String                @db.Uuid
  userId                String                @db.Uuid
  canEdit               Boolean               @default(false) @map("can_edit")
  canDelete             Boolean               @default(false) @map("can_delete")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  configuration         WarningConfiguration  @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([configurationId, userId])
  @@index([configurationId])
  @@index([userId])
  @@index([canEdit])
  @@index([canDelete])
}
