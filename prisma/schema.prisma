/// SystemSetting - Global application configuration settings
model SystemSetting {
  /// Setting key (primary key)
  key       String   @id
  /// Setting value
  value     String?
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Last update timestamp
  updatedAt DateTime @default(now()) @updatedAt

  @@index([updatedAt])
}

/// CustomFieldDefinition - Custom field schema definitions for extensible data models
model CustomFieldDefinition {
  /// Unique identifier
  id                        String              @id @default(uuid()) @db.Uuid
  /// Target model name (Applicant, Position, etc.)
  modelName                 String              @map("model_name")
  /// Field key for API access
  fieldKey                  String              @map("field_key")
  /// Display label
  label                     String
  /// Field type (text, number, select, etc.)
  fieldType                 String              @map("field_type")
  /// Field options (JSON)
  options                   Json?
  /// Whether field is required
  isRequired                Boolean             @default(false) @map("is_required")
  /// Sort order for display
  sortOrder                 Int                 @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt                 DateTime            @default(now())
  /// Last update timestamp
  updatedAt                 DateTime            @default(now())
  /// Allow custom user options
  allowCustomOptions        Boolean             @default(false) @map("allow_custom_options")
  /// Attribute code for mapping
  attributeCode             String?             @map("attribute_code")
  /// Attribute label for display
  attributeLabel            String?             @map("attribute_label")
  /// Roles allowed to edit
  editRoles                 String[]            @default([]) @map("edit_roles")
  /// Field code identifier
  fieldCode                 String              @map("field_code")
  /// Show in applicant detail view
  showInApplicantDetail     Boolean             @default(false) @map("show_in_applicant_detail")
  /// Show in filter options
  showInFilter              Boolean             @default(false) @map("show_in_filter")
  /// Show in full applicant detail
  showInFullApplicantDetail Boolean             @default(false) @map("show_in_full_applicant_detail")
  /// Show in headcount detail view
  showInHeadcountDetail     Boolean             @default(false) @map("show_in_headcount_detail")
  /// Show in position settings
  showInPositionSettings    Boolean             @default(false) @map("show_in_position_settings")
  /// Show in task board filter
  showInTaskBoardFilter     Boolean             @default(false) @map("show_in_task_board_filter")
  /// Applicant detail section
  applicantDetailSection    String?             @map("applicant_detail_section")
  /// Position detail section
  positionDetailSection     String?             @map("position_detail_section")
  /// Roles allowed to view
  viewRoles                 String[]            @default([]) @map("view_roles")
  customFieldOptions        CustomFieldOption[]

  @@unique([modelName, fieldKey])
  @@unique([modelName, fieldCode])
  @@index([modelName])
  @@index([sortOrder])
  @@index([viewRoles])
  @@index([editRoles])
}

/// CustomFieldOption - Predefined options for custom dropdown/select fields
model CustomFieldOption {
  /// Unique identifier
  id                      String                @id @default(uuid()) @db.Uuid
  /// Reference to field definition
  customFieldDefinitionId String                @map("custom_field_definition_id") @db.Uuid
  /// Option value
  value                   String
  /// Display label
  label                   String
  /// Display color
  color                   String?               @default("#3B82F6")
  /// Sort order for display
  sortOrder               Int                   @default(0) @map("sort_order")
  /// Whether option is active
  isActive                Boolean               @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt               DateTime              @default(now())
  /// Last update timestamp
  updatedAt               DateTime              @default(now())
  customFieldDefinition   CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([customFieldDefinitionId, value])
  @@index([customFieldDefinitionId])
  @@index([sortOrder])
  @@index([isActive])
}

/// JobMatch - AI-generated job matching results for applicants
model JobMatch {
  /// Unique identifier
  id                    String     @id @default(uuid()) @db.Uuid
  /// Reference to applicant
  jobId                 String?    @db.Uuid
  /// Matched job title
  jobTitle              String?    @map("jobTitle")
  /// AI-calculated fit score (0-100)
  fitScore              Float?     @map("fitScore")
  /// Reasons for the match
  matchReasons          String[]   @map("matchReasons")
  /// Summary of job description
