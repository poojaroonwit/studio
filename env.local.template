# =================================================================
# Local Development Environment Configuration
# =================================================================
# This file contains environment variables for local development
# Copy this file to .env.local and update values as needed


# =================================================================
# Application Configuration
# =================================================================
NODE_ENV=development
APP_PORT=8021
NEXT_TELEMETRY_DISABLED=1
APP_TIMEZONE=Asia/Bangkok


# =================================================================
# Database Configuration (PostgreSQL)
# =================================================================
# The application only reads DATABASE_URL for PostgreSQL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE

# =================================================================
# Object Storage Configuration (S3-compatible)
# =================================================================
# Use Railway buckets, AWS S3, or any S3-compatible provider.
STORAGE_PROVIDER=s3-compatible
STORAGE_ENDPOINT=https://CHANGE_THIS_STORAGE_ENDPOINT
STORAGE_ACCESS_KEY_ID=CHANGE_THIS_STORAGE_ACCESS_KEY
STORAGE_SECRET_ACCESS_KEY=CHANGE_THIS_STORAGE_SECRET_KEY
STORAGE_BUCKET=hri
STORAGE_PUBLIC_BASE_URL=https://CHANGE_THIS_STORAGE_PUBLIC_BASE_URL


# =================================================================
# Authentication Configuration
# =================================================================
# Generate a secure secret: openssl rand -base64 32
NEXTAUTH_SECRET=hri-local-nextauth-secret-change-me-32
NEXTAUTH_URL=http://localhost:8021

# =================================================================
# Azure AD Configuration (Optional - for SSO)
# =================================================================
# If you want to use Azure AD for authentication, uncomment and configure these
# AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# AZURE_AD_CLIENT_SECRET=your_azure_ad_client_secret
# AZURE_AD_TENANT_ID=your_azure_ad_tenant_id
# NEXT_PUBLIC_AZURE_AD_CLIENT_ID=your_azure_ad_client_id
# NEXT_PUBLIC_AZURE_AD_TENANT_ID=your_azure_ad_tenant_id


# =================================================================
# External API Keys (Optional)
# =================================================================
# Google API Key for fonts and other Google services
# GOOGLE_API_KEY=your_google_api_key
# OPENAI_API_KEY=your_openai_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key
# NEXT_PUBLIC_GOOGLE_FONTS_API_KEY=your_google_api_key


# =================================================================
# Webhook Configuration (Optional)
# =================================================================
# URLs for external webhook processing (leave empty for local development)
# RESUME_PROCESSING_WEBHOOK_URL=your_resume_processing_webhook_url
# RESUME_PROCESSING_WEBHOOK_TOKEN=your_resume_processing_webhook_token
# GENERAL_PDF_WEBHOOK_URL=your_general_pdf_webhook_url
# GENERAL_PDF_WEBHOOK_TOKEN=your_general_pdf_webhook_token
# RESUME_PROCESSING_WEBHOOK_TIMEOUT=1800
# WEBHOOK_CONNECTION_TIMEOUT=900
# Built-in upload queue processing uses the app service and NEXTAUTH_SECRET.
# Optional for external workers only:
# PROCESSOR_API_KEY=your-external-worker-key
# UPLOAD_QUEUE_PROCESS_URL=https://your-app.example.com/api/upload-queue/process


# =================================================================
# Real-time Configuration (SSE)
# =================================================================
# SSE is used for real-time updates instead of WebSocket
# UNIFIED: All SSE endpoints now use single connection per user
# No additional configuration needed for SSE








# =================================================================
# Development Configuration
# =================================================================
# Note: INTERNAL_SERVER_IP and INTERNAL_DOMAIN are not used in the application

# SECURITY: File access configuration
# ALLOW_PUBLIC_FILES=false  # NEVER set to true - security risk!
# USE_SIGNED_URLS_IN_WEBHOOKS=true  # Always use signed URLs for secure access


# =================================================================
# Build and Optimization Controls
# =================================================================
# Set to 'true' to disable client-side optimization/minification in builds
# Useful for diagnosing TDZ/circular dependency issues locally
# DISABLE_OPTIMIZATION=true
