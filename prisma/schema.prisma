generator client {
  provider = "prisma-client-js"
}

generator comments {
  provider = "prisma-db-comments-generator"
  output   = "./migrations/comments.sql"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


/// User - Core user table for authentication, profile management, and access control
model User {
  /// Unique identifier (UUID)
  id                          String                      @id @default(uuid()) @db.Uuid
  /// Full name of the user
  name                        String
  /// Email address (unique, used for login)
  email                       String                      @unique
  /// Hashed password for authentication
  password                    String
  /// User role (admin, recruiter, hiring_manager, viewer)
  role                        String
  /// URL to user avatar image
  avatarUrl                   String?
  /// Alternative image URL
  image                       String?
  /// AI hint for data processing
  dataAiHint                  String?
  /// Authentication methods (basic, azure_ad) - supports multiple methods
  authenticationMethods       String[]                    @default(["basic"]) @map("authentication_methods")
  /// Flag to force password change on next login
  forcePasswordChange         Boolean                     @default(false) @map("force_password_change")
  /// Timestamp when email was verified
  emailVerified               DateTime?
  /// Whether the user account is active
  isActive                    Boolean                     @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt                   DateTime                    @default(now())
  /// Last update timestamp
  updatedAt                   DateTime                    @updatedAt
  /// Azure AD Object ID for SSO
  azure_oid                   String?                     @unique
  /// Reference to user group
  userGroupId                 String?                     @map("userGroupId") @db.Uuid
  /// Reference to user team
  userTeamId                  String?                     @map("userTeamId") @db.Uuid
  /// Array of module permissions
  module_permissions          String[]                    @default([])
  /// Personal theme color
  personalColor               String?                     @default("#2c5ecaff") @map("personal_color")
  /// Job title within the organization
  positionTitle               String?                     @map("position_title")
  /// Department name
  department                  String?
  /// Contact phone number
  phoneNumber                 String?                     @map("phone_number")
  /// Office location
  officeLocation              String?                     @map("office_location")
  
  // Azure AD Profile Fields
  /// Azure AD Employee ID
  employeeId                  String?                     @map("employee_id")
  /// Company name associated with user
  companyName                 String?                     @map("company_name")
  /// Employee type (Full-time, Contractor, etc.)
  employeeType                String?                     @map("employee_type")
  /// Date of hire
  hireDate                    DateTime?                   @map("hire_date")
  /// Manager's display name
  manager                     String?                     // Manager display name from Azure AD
  /// Manager's email address
  managerEmail                String?                     @map("manager_email")
  /// SAM Account Name (legacy)
  samAccountName              String?                     @map("sam_account_name")
  /// Detailed contact info (JSON)
  contactInfo                 Json?                       @map("contact_info")
  /// Whether user is deleted from Azure AD
  deletedFromAD               Boolean                     @default(false) @map("deleted_from_ad")
  // contactInfo JSON structure:
  // { streetAddress, city, stateOrProvince, postalCode, country, 
  //   businessPhone, mobilePhone, otherEmails[] }

  // Account Lockout Fields
  /// Number of failed login attempts
  failedLoginAttempts         Int                         @default(0) @map("failed_login_attempts")
  /// Timestamp until which account is locked
  lockedUntil                 DateTime?                   @map("locked_until")
  /// Timestamp of last failed login
  lastFailedLogin             DateTime?                   @map("last_failed_login")
  
  // Two-Factor Authentication fields
  /// Whether 2FA is enabled
  twoFactorEnabled      Boolean   @default(false) @map("two_factor_enabled")
  /// 2FA method (totp, email)
  twoFactorMethod       String?   @map("two_factor_method") // "totp" | "email"
  /// Encrypted 2FA secret
  twoFactorSecret       String?   @map("two_factor_secret") // Encrypted TOTP secret
  /// Encrypted backup codes
  twoFactorBackupCodes  String[]  @default([]) @map("two_factor_backup_codes") // Encrypted backup codes
  /// Timestamp of 2FA verification
  twoFactorVerifiedAt   DateTime? @map("two_factor_verified_at")

  // Relations
  accounts                    Account[]
  attachments                 Attachment[]                @relation("UserAttachments")
  candidates                  Candidate[]                 @relation("RecruiterCandidates")
  candidateComments           CandidateComment[]          @relation("UserComments")
  evaluations                 CandidateEvaluation[]
  Dashboard                   Dashboard[]
  DashboardShare              DashboardShare[]
  logEntries                  LogEntry[]                  @relation("UserLogEntries")
  notifications               Notification[]
  positions                   Position[]                  @relation("RecruiterPositions")
  createdPositionInterviewers PositionInterviewer[]       @relation("PositionInterviewerCreator")
  positionInterviewers        PositionInterviewer[]
  transitionRecords           TransitionRecord[]          @relation("ActingUserTransitions")
  userGroup                   UserGroup?                  @relation("UserUserGroup", fields: [userGroupId], references: [id])
  userTeam                    UserTeam?                   @relation("UserUserTeam", fields: [userTeamId], references: [id])
  userPreferences             UserUIDisplayPreference[]

  uploadQueue                 UploadQueue[]               @relation("UserUploadQueue")
  createdEvaluationLinks      CandidateEvaluationLink[]
  activityLogs                UserActivityLog[]           @relation("UserActivityLogs")
  sessions                    UserSession[]               @relation("UserSessions")

  @@index([email])
  @@index([role])
  @@index([authenticationMethods])
  @@index([userGroupId])
  @@index([userTeamId])
  @@index([isActive])
  @@index([employeeId])
  @@index([deletedFromAD])
}

// User Activity Log - tracks all user-related actions

/// UserActivityLog - Tracks all user-related actions for audit and security
model UserActivityLog {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Reference to the user
  userId      String   @map("user_id") @db.Uuid
  /// Action type (SIGN_IN, SIGN_OUT, PASSWORD_CHANGE, etc.)
  action      String   // Action type (see comment below)
  /// Additional context for the action (JSON)
  details     Json?    // Additional context for the action
  /// IP address of the request
  ipAddress   String?  @map("ip_address")
  /// Browser user agent string
  userAgent   String?  @map("user_agent")
  /// Who performed the action (for admin actions)
  performedBy String?  @map("performed_by") @db.Uuid // Who performed the action (for admin actions)
  /// Timestamp of the action
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Activity types:
  // SIGN_IN, SIGN_OUT, SIGN_IN_FAILED, PASSWORD_CHANGE, PASSWORD_RESET,
  // PROFILE_UPDATE, PERMISSIONS_CHANGE, ROLE_CHANGE, GROUP_CHANGE, TEAM_CHANGE,
  // ACCOUNT_ENABLED, ACCOUNT_DISABLED, ACCOUNT_CREATED, ACCOUNT_DELETED,
  // AD_SYNC_CREATED, AD_SYNC_UPDATE, DELETED_FROM_AD, SESSION_EXPIRED,
  // API_TOKEN_GENERATED, MFA_ENABLED, MFA_DISABLED
  
  user        User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([performedBy])
}


/// Position - Job positions available for recruitment
model Position {
  /// Unique identifier
  id                String                     @id @default(uuid()) @db.Uuid
  /// Job title
  title             String
  /// Department name
  department        String
  /// Job description
  description       String?
  /// Criteria for candidate matching
  matchCriteria     String?
  /// Whether position is open for applications
  isOpen            Boolean                    @default(true)
  /// Seniority level (Entry, Mid, Senior, etc.)
  positionLevel     String?
  /// Assigned recruiter
  recruiterId       String?                    @db.Uuid
  /// Custom attributes (JSON)
  customAttributes  Json?                      @default("{}")
  /// Record creation timestamp
  createdAt         DateTime                   @default(now())
  /// Last update timestamp
  updatedAt         DateTime                   @updatedAt
  /// Company identifier
  companyId         String?                    @db.Uuid
  /// Reference to grade level
  gradeId           String?                    @db.Uuid
  /// Additional position attributes
  positionAttribute String?
  candidates        Candidate[]
  evaluations       CandidateEvaluation[]
  headcounts        Headcount[]                @relation("PositionHeadcount")
  grade             Grade?                     @relation(fields: [gradeId], references: [id])
  recruiter         User?                      @relation("RecruiterPositions", fields: [recruiterId], references: [id])
  expertiseGroups   PositionExpertiseGroup[]
  expertiseSkills   PositionExpertiseSkill[]
  interviewers      PositionInterviewer[]
  personalityGroups PositionPersonalityGroup[]
  personalityTraits PositionPersonalityTrait[]
  transitionRecords TransitionRecord[]

  @@index([title])
  @@index([department])
  @@index([isOpen])
  @@index([recruiterId])
}


/// Grade - Job grade levels with SLA and level configurations
model Grade {
  /// Unique identifier
  id          String     @id @default(uuid()) @db.Uuid
  /// Grade name (e.g., G1, G2)
  name        String     @unique
  /// Display label
  label       String?
  /// Grade description
  description String?
  /// Minimum level number
  minLevel    Int        @map("min_level")
  /// Maximum level number
  maxLevel    Int        @map("max_level")
  /// SLA days for this grade
  slaDays     Int        @map("sla_days")
  /// Display color
  color       String     @default("#3B82F6")
  /// Whether grade is active
  isActive    Boolean    @default(true) @map("is_active")
  /// Sort order for display
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  positions   Position[]

  @@index([minLevel])
  @@index([maxLevel])
  @@index([isActive])
  @@index([sortOrder])
}


/// PositionLevel - Position seniority levels (Entry, Junior, Mid, Senior, etc.)
model PositionLevel {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Level name (e.g., Entry, Junior, Mid, Senior)
  name        String   @unique
  /// Level description
  description String?
  /// Display color
  color       String   @default("#6B7280")
  /// Whether level is active
  isActive    Boolean  @default(true) @map("is_active")
  /// Sort order for display
  sortOrder   Int      @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt   DateTime @default(now())
  /// Last update timestamp
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}


/// Candidate - Job applicants and their application data
model Candidate {
  /// Unique identifier
  id                      String                @id @default(uuid()) @db.Uuid
  /// Candidate full name
  name                    String
  /// Email address
  email                   String
  /// Phone number
  phone                   String?
  /// Applied position reference
  positionId              String?               @db.Uuid
  /// Assigned recruiter reference
  recruiterId             String?               @db.Uuid
  /// AI-calculated fit score (0-100)
  fitScore                Float?                @default(0)
  /// Application submission date
  applicationDate         DateTime              @default(now())
  /// Parsed resume data (JSON)
  parsedData              Json?
  /// Custom attributes (JSON)
  customAttributes        Json?                 @default("{}")
  /// Path to uploaded resume file
  resumePath              String?
  /// Record creation timestamp
  createdAt               DateTime              @default(now())
  /// Last update timestamp
  updatedAt               DateTime              @updatedAt
  /// Avatar image URL
  avatarUrl               String?
  /// AI hint for processing
  dataAiHint              String?
  /// Justification for position assignment
  assignmentJustification String?
  /// Education history (JSON array)
  educationData           Json?                 @default("[]")
  /// Work experience history (JSON array)
  experienceData          Json?                 @default("[]")
  /// Company identifier
  companyId               String?               @db.Uuid
  /// Candidate source reference
  sourceId                String?               @db.Uuid
  /// Sub-source detail
  subSource               String?
  /// Current recruitment status
  statusId                String?               @db.Uuid
  /// Whether candidate is blacklisted
  isBlacklisted           Boolean               @default(false) @map("is_blacklisted")
  /// Whether candidate is pinned
  isPinned                Boolean               @default(false)
  /// Pin timestamp
  pinnedAt                DateTime?
  /// Email received date
  emailDate               DateTime?
  /// Email subject line
  emailSubject            String?
  /// Email message ID
  emailId                 String?
  /// Email metadata (JSON)
  emailMetadata           Json?
  /// Expected salary amount
  expectedSalary          Int?                  @map("expected_salary")
  attachments             Attachment[]
  position                Position?             @relation(fields: [positionId], references: [id])
  recruiter               User?                 @relation("RecruiterCandidates", fields: [recruiterId], references: [id])
  source                  CandidateSource?      @relation(fields: [sourceId], references: [id])
  recruitmentStage        RecruitmentStage?     @relation("RecruitmentStageCandidates", fields: [statusId], references: [id], onUpdate: NoAction)
  candidateComments       CandidateComment[]
  evaluations             CandidateEvaluation[]
  headcounts              Headcount[]           @relation("CandidateHeadcount")
  jobMatches              JobMatch[]
  transitionRecords       TransitionRecord[]
  evaluationLinks         CandidateEvaluationLink[]

  @@index([email])
  @@index([positionId])
  @@index([recruiterId])
  @@index([applicationDate])
  @@index([fitScore])
  @@index([sourceId])
  @@index([statusId])
  @@index([isPinned])
  @@index([pinnedAt])
}


/// RecruitmentStage - Pipeline stages for candidate recruitment workflow
model RecruitmentStage {
  /// Unique identifier
  id             String      @id @default(uuid()) @db.Uuid
  /// Stage name
  name           String      @unique
  /// Stage description
  description    String?
  /// Whether this is a system-defined stage
  isSystem       Boolean     @map("is_system")
  /// Sort order for display
  sortOrder      Int         @map("sort_order")
  /// Color when stage is complete
  color_complete String?
  /// Badge color
  color_badge    String?
  candidates     Candidate[] @relation("RecruitmentStageCandidates")

  @@index([sortOrder])
  @@index([isSystem])
}


/// TransitionRecord - History of candidate stage transitions
model TransitionRecord {
  /// Unique identifier
  id           String    @id @default(uuid()) @db.Uuid
  /// Reference to candidate
  candidateId  String    @db.Uuid
  /// Reference to position
  positionId   String?   @db.Uuid
  /// Transition date
  date         DateTime  @default(now())
  /// Stage name at transition
  stage        String
  /// Transition notes
  notes        String?
  /// User who performed the transition
  actingUserId String?   @db.Uuid
  /// Record creation timestamp
  createdAt    DateTime  @default(now())
  /// Last update timestamp
  updatedAt    DateTime  @updatedAt
  actingUser   User?     @relation("ActingUserTransitions", fields: [actingUserId], references: [id])
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  position     Position? @relation(fields: [positionId], references: [id])

  @@index([candidateId])
  @@index([actingUserId])
  @@index([date])
  @@index([stage])
  @@index([positionId])
}


/// LogEntry - General system and application logging
model LogEntry {
  /// Unique identifier
  id           String   @id @default(uuid()) @db.Uuid
  /// Log timestamp
  timestamp    DateTime @default(now())
  /// Log level (INFO, WARN, ERROR, DEBUG)
  level        String
  /// Log message content
  message      String
  /// Log source/component
  source       String?
  /// User who triggered the log
  actingUserId String?  @db.Uuid
  /// Additional log details (JSON)
  details      Json?
  /// Record creation timestamp
  createdAt    DateTime @default(now())
  actingUser   User?    @relation("UserLogEntries", fields: [actingUserId], references: [id])

  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@index([actingUserId])
}


/// AuditLog - Security and compliance audit trail
model AuditLog {
  /// Unique identifier
  id           String   @id @default(uuid()) @db.Uuid
  /// Log level (INFO, WARN, ERROR)
  level        String
  /// Audit message
  message      String
  /// Event source/component
  source       String?
  /// User who triggered the action
  actingUserId String?  @db.Uuid
  /// Additional details (JSON)
  details      Json?
  /// Event timestamp
  timestamp    DateTime @default(now())
  /// Target user ID (for user-related actions)
  user_id      String?  @db.Uuid
  /// Action type performed
  action       String?
  /// Entity type affected
  entity       String?
  /// Entity ID affected
  entity_id    String?  @db.Uuid

  @@index([timestamp])
  @@index([level])
  @@index([source])
  @@index([actingUserId])
  @@index([user_id])
}


/// UserGroup - User permission groups for role-based access control
model UserGroup {
  /// Unique identifier
  id           String   @id @default(uuid()) @db.Uuid
  /// Group name
  name         String   @unique
  /// Group description
  description  String?
  /// Array of permission strings
  permissions  String[] @default([])
  /// Whether this is the default group
  isDefault    Boolean  @default(false) @map("is_default")
  /// Whether this is a system-defined role
  isSystemRole Boolean  @default(false) @map("is_system_role")
  /// Record creation timestamp
  createdAt    DateTime @default(now())
  /// Last update timestamp
  updatedAt    DateTime @updatedAt
  users        User[]   @relation("UserUserGroup")

  @@index([isDefault])
  @@index([isSystemRole])
}


/// UserTeam - Teams for organizing users within the organization
model UserTeam {
  /// Unique identifier
  id          String   @id @default(uuid()) @db.Uuid
  /// Team name
  name        String   @unique
  /// Team description
  description String?
  /// Display color
  color       String?  @default("#3B82F6")
  /// Whether team is active
  isActive    Boolean  @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt   DateTime @default(now())
  /// Last update timestamp
  updatedAt   DateTime @default(now())
  users       User[]   @relation("UserUserTeam")

  @@index([isActive])
}


/// SystemSetting - Global application configuration settings
model SystemSetting {
  /// Setting key (primary key)
  key       String   @id
  /// Setting value
  value     String?
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Last update timestamp
  updatedAt DateTime @default(now()) @updatedAt

  @@index([updatedAt])
}


/// CustomFieldDefinition - Custom field schema definitions for extensible data models
model CustomFieldDefinition {
  /// Unique identifier
  id                        String              @id @default(uuid()) @db.Uuid
  /// Target model name (Candidate, Position, etc.)
  modelName                 String              @map("model_name")
  /// Field key for API access
  fieldKey                  String              @map("field_key")
  /// Display label
  label                     String
  /// Field type (text, number, select, etc.)
  fieldType                 String              @map("field_type")
  /// Field options (JSON)
  options                   Json?
  /// Whether field is required
  isRequired                Boolean             @default(false) @map("is_required")
  /// Sort order for display
  sortOrder                 Int                 @default(0) @map("sort_order")
  /// Record creation timestamp
  createdAt                 DateTime            @default(now())
  /// Last update timestamp
  updatedAt                 DateTime            @default(now())
  /// Allow custom user options
  allowCustomOptions        Boolean             @default(false) @map("allow_custom_options")
  /// Attribute code for mapping
  attributeCode             String?             @map("attribute_code")
  /// Attribute label for display
  attributeLabel            String?             @map("attribute_label")
  /// Roles allowed to edit
  editRoles                 String[]            @default([]) @map("edit_roles")
  /// Field code identifier
  fieldCode                 String              @map("field_code")
  /// Show in candidate detail view
  showInCandidateDetail     Boolean             @default(false) @map("show_in_candidate_detail")
  /// Show in filter options
  showInFilter              Boolean             @default(false) @map("show_in_filter")
  /// Show in full candidate detail
  showInFullCandidateDetail Boolean             @default(false) @map("show_in_full_candidate_detail")
  /// Show in headcount detail view
  showInHeadcountDetail     Boolean             @default(false) @map("show_in_headcount_detail")
  /// Show in position settings
  showInPositionSettings    Boolean             @default(false) @map("show_in_position_settings")
  /// Show in task board filter
  showInTaskBoardFilter     Boolean             @default(false) @map("show_in_task_board_filter")
  /// Candidate detail section
  candidateDetailSection    String?             @map("candidate_detail_section")
  /// Position detail section
  positionDetailSection     String?             @map("position_detail_section")
  /// Roles allowed to view
  viewRoles                 String[]            @default([]) @map("view_roles")
  customFieldOptions        CustomFieldOption[]

  @@unique([modelName, fieldKey])
  @@unique([modelName, fieldCode])
  @@index([modelName])
  @@index([sortOrder])
  @@index([viewRoles])
  @@index([editRoles])
}


/// CustomFieldOption - Predefined options for custom dropdown/select fields
model CustomFieldOption {
  /// Unique identifier
  id                      String                @id @default(uuid()) @db.Uuid
  /// Reference to field definition
  customFieldDefinitionId String                @map("custom_field_definition_id") @db.Uuid
  /// Option value
  value                   String
  /// Display label
  label                   String
  /// Display color
  color                   String?               @default("#3B82F6")
  /// Sort order for display
  sortOrder               Int                   @default(0) @map("sort_order")
  /// Whether option is active
  isActive                Boolean               @default(true) @map("is_active")
  /// Record creation timestamp
  createdAt               DateTime              @default(now())
  /// Last update timestamp
  updatedAt               DateTime              @default(now())
  customFieldDefinition   CustomFieldDefinition @relation(fields: [customFieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([customFieldDefinitionId, value])
  @@index([customFieldDefinitionId])
  @@index([sortOrder])
  @@index([isActive])
}


/// JobMatch - AI-generated job matching results for candidates
model JobMatch {
  /// Unique identifier
  id                    String    @id @default(uuid()) @db.Uuid
  /// Reference to candidate
  candidateId           String    @db.Uuid
  /// Reference to matched job
  jobId                 String?   @db.Uuid
  /// Matched job title
  jobTitle              String?   @map("jobTitle")
  /// AI-calculated fit score (0-100)
  fitScore              Float?    @map("fitScore")
  /// Reasons for the match
  matchReasons          String[]  @map("matchReasons")
  /// Summary of job description
  jobDescriptionSummary String?   @map("job_description_summary")
  /// Record creation timestamp
  createdAt             DateTime  @default(now())
  /// Last update timestamp
  updatedAt             DateTime  @updatedAt
  /// Company identifier
  companyId             String?   @db.Uuid
  candidate             Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([jobId])
  @@index([fitScore])
}


/// UploadQueue - Queue for processing uploaded resume files
model UploadQueue {
  /// Unique identifier
  id              String           @id @default(uuid()) @db.Uuid
  /// Original file name
  fileName        String           @map("file_name")
  /// File size in bytes
  fileSize        BigInt           @map("file_size")
  /// Processing status (pending, processing, completed, failed)
  status          String
  /// Error message if failed
  error           String?
  /// Detailed error information
  errorDetails    String?          @map("error_details")
  /// Source name
  source          String?
  /// Reference to candidate source
  sourceId        String?          @map("source_id") @db.Uuid
  /// Sub-source detail
  subSource       String?          @map("sub_source")
  /// Upload timestamp
  uploadDate      DateTime         @default(now()) @map("upload_date")
  /// Processing completion timestamp
  completedDate   DateTime?        @map("completed_date")
  /// Upload batch ID
  uploadId        String?          @map("upload_id")
  /// User who created the upload
  createdBy       String?          @map("created_by") @db.Uuid
  /// Last update timestamp
  updatedAt       DateTime         @default(now()) @map("updated_at")
  /// File storage path
  filePath        String           @map("file_path")
  /// Webhook response payload
  webhookPayload  Json?            @map("webhook_payload")
  /// Number of retry attempts
  retryCount      Int              @default(0) @map("retry_count")
  /// Target position reference
  positionId      String?          @map("position_id") @db.Uuid
  /// Processing date
  processDate     DateTime?        @map("process_date")
  /// Email received date
  emailDate       DateTime?        @map("email_date")
  /// Email subject line
  emailSubject    String?          @map("email_subject")
  /// Email message ID
  emailId         String?          @map("email_id")
  /// Email metadata (JSON)
  emailMetadata   Json?            @map("email_metadata")
  createdByUser   User?            @relation("UserUploadQueue", fields: [createdBy], references: [id])
  candidateSource CandidateSource? @relation("UploadQueueCandidateSource", fields: [sourceId], references: [id])

  @@unique([filePath, status], name: "unique_file_path_status")
  @@index([status])
  @@index([uploadDate])
  @@index([completedDate])
  @@index([processDate])
  @@index([createdBy])
  @@index([source])
  @@index([sourceId])
  @@map("upload_queue")
}


/// UserUIDisplayPreference - User-specific UI display preferences
model UserUIDisplayPreference {
  /// Unique identifier
  id           String   @id @default(uuid()) @db.Uuid
  /// Reference to user
  userId       String   @map("userId") @db.Uuid
  /// Model type for preference
  modelType    String   @map("model_type")
  /// Attribute key
  attributeKey String   @map("attribute_key")
  /// UI preference value
  uiPreference String   @map("ui_preference")
  /// Custom note
  customNote   String?  @map("custom_note")
  /// Record creation timestamp
  createdAt    DateTime @default(now())
  /// Last update timestamp
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modelType, attributeKey])
  @@index([userId])
  @@index([modelType])
  @@index([attributeKey])
}


/// Account - OAuth/external authentication provider accounts
model Account {
  /// Unique identifier
  id                String  @id @default(uuid()) @db.Uuid
  /// Reference to user
  userId            String  @db.Uuid
  /// Account type
  type              String
  /// OAuth provider name
  provider          String
  /// Provider account ID
  providerAccountId String
  /// OAuth refresh token
  refresh_token     String?
  /// OAuth access token
  access_token      String?
  /// Token expiration timestamp
  expires_at        Int?
  /// OAuth token type
  token_type        String?
  /// OAuth scope
  scope             String?
  /// OAuth ID token
  id_token          String?
  /// OAuth session state
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}


/// SystemPreference - User-specific system preferences
model SystemPreference {
  /// Unique identifier
  id        String   @id @default(uuid()) @db.Uuid
  /// Reference to user
  userId    String   @db.Uuid
  /// Preference key
  key       String
  /// Preference value
  value     String?
  /// Record creation timestamp
  createdAt DateTime @default(now())
  /// Last update timestamp
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
}


/// CandidateComment - Comments and notes on candidate profiles
model CandidateComment {
  /// Unique identifier
  id            String    @id @default(uuid()) @db.Uuid
  /// Reference to candidate
  candidateId   String    @db.Uuid
  /// Comment author reference
  authorId      String    @db.Uuid
  /// Comment content
  content       String
  /// Record creation timestamp
  createdAt     DateTime  @default(now())
  /// Last update timestamp
  updatedAt     DateTime  @updatedAt
  /// Referenced attachment IDs
  attachmentIds String[]
  author        User      @relation("UserComments", fields: [authorId], references: [id], onDelete: Cascade)
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([authorId])
}


/// Attachment - File attachments for candidates and headcounts
model Attachment {
  /// Unique identifier
  id           String     @id @default(uuid()) @db.Uuid
  /// Reference to candidate
  candidateId  String?    @db.Uuid
  /// User who uploaded the file
  uploadedById String     @db.Uuid
  /// File storage path
  filePath     String
  /// Original file name
  fileName     String
  /// File label/category
  label        String
  /// Whether this is the primary attachment
  isPrimary    Boolean    @default(false)
  /// Upload timestamp
  uploadedAt   DateTime   @default(now())
  /// Last update timestamp
  updatedAt    DateTime   @updatedAt
  /// Reference to headcount
  headcountId  String?    @db.Uuid
  candidate    Candidate? @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  headcount    Headcount? @relation("HeadcountAttachments", fields: [headcountId], references: [id], onDelete: Cascade)
  uploadedBy   User       @relation("UserAttachments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@index([headcountId])
  @@index([uploadedById])
  @@index([label])
  @@index([isPrimary])
}


/// Webhook - Outbound webhook configurations for event notifications
model Webhook {
  /// Unique identifier
  id                String              @id @default(uuid()) @db.Uuid
  /// Webhook name
  name              String
  /// Target URL
  url               String
  /// HTTP method (POST, PUT, etc.)
  method            String
  /// Custom headers (JSON)
  headers           Json?
  /// Custom auth header name
  auth_header_name  String?             @map("auth_header_name")
  /// Custom auth header value
  auth_header_value String?             @map("auth_header_value")
  /// Basic auth password
  auth_password     String?             @map("auth_password")
  /// Bearer token
  auth_token        String?             @map("auth_token")
  /// Auth type (none, basic, bearer, header)
  auth_type         String              @default("none") @map("auth_type")
  /// Basic auth username
  auth_username     String?             @map("auth_username")
  /// Record creation timestamp
  createdAt         DateTime            @default(now()) @map("createdAt")
  /// Event types to trigger on
  events            String[]
  /// Whether webhook is active
  is_active         Boolean             @default(true) @map("is_active")
  /// Number of retry attempts
  retry_count       Int                 @default(3) @map("retry_count")
  /// Request timeout in seconds
  timeout           Int                 @default(30)
  /// Last update timestamp
  updatedAt         DateTime            @updatedAt @map("updatedAt")
  /// Default body template
  body_template     String?             @map("body_template")
  /// Field mappings configuration
  field_mappings    Json?               @map("field_mappings")
  /// Include metadata in payload
  include_metadata  Boolean             @default(true) @map("include_metadata")
  /// Use custom payload format
  custom_payload    Boolean             @default(false) @map("custom_payload")
  body_configs      WebhookBodyConfig[]
  logs              WebhookLog[]

  @@index([is_active])
  @@index([events])
  @@index([createdAt])
}


/// WebhookBodyConfig - Custom body templates for webhook events
model WebhookBodyConfig {
  /// Unique identifier
  id             String   @id @default(uuid()) @db.Uuid
  /// Reference to webhook
  webhook_id     String   @map("webhook_id") @db.Uuid
  /// Event type for this config
  event_type     String   @map("event_type")
  /// Body template content
  body_template  String   @map("body_template")
  /// Field mappings (JSON)
  field_mappings Json?    @map("field_mappings")
  /// Whether config is active
  is_active      Boolean  @default(true) @map("is_active")
  /// Record creation timestamp
  created_at     DateTime @default(now()) @map("created_at")
  /// Last update timestamp
  updated_at     DateTime @updatedAt @map("updated_at")
  webhook        Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@unique([webhook_id, event_type])
  @@index([webhook_id])
  @@index([event_type])
  @@index([is_active])
}


/// WebhookLog - Execution logs for webhook deliveries
model WebhookLog {
  /// Unique identifier
  id              String   @id @default(uuid()) @db.Uuid
  /// Reference to webhook
  webhook_id      String   @map("webhook_id") @db.Uuid
  /// Event type triggered
  event_type      String   @map("event_type")
  /// Request payload (JSON)
  payload         Json
  /// HTTP response status code
  response_status Int?     @map("response_status")
  /// Response body content
  response_body   String?  @map("response_body")
  /// Whether delivery was successful
  success         Boolean
  /// Error message if failed
  error_message   String?  @map("error_message")
  /// Request duration in milliseconds
  duration_ms     Int      @default(0) @map("duration_ms")
  /// Log creation timestamp
  createdAt       DateTime @default(now()) @map("createdAt")
  webhook         Webhook  @relation(fields: [webhook_id], references: [id], onDelete: Cascade)

  @@index([webhook_id])
  @@index([event_type])
  @@index([success])
  @@index([createdAt])
}


/// Dashboard - Custom dashboard configurations for analytics
model Dashboard {
  /// Unique identifier
  id              String            @id @db.Uuid
