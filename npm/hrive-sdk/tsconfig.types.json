{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "../../src/sdk",
    "skipLibCheck": true
  },
  "include": ["../../src/sdk/**/*.ts"],
  "exclude": ["../../src/sdk/**/*.test.ts"]
}
